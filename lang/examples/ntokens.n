// ntokens.n — an N tokenizer written in N (the first link of M5):
//   a program in the language reads a snippet OF the language and emits
//   its token stream. Everything it needs shipped in the last few
//   versions: s[i] byte reads (v0.15), for-ranges (v0.11), enums + match
//   as an expression (v0.7/v0.9), #[caps]/#[user] boundaries (v0.12-14),
//   and addr casts for the one place a sub-span must become a pointer.
//   Grown toward the real N lexer surface: it now recognizes line
//   comments, string literals (with backslash escapes skipped, so an
//   embedded \" cannot end the scan early), and the two-character
//   operators := -> == != <= >= .. += -= that pepper any real N source.
//   FILE-DRIVEN since the selfhost road's rung 1: the second half opens
//   a real .n source file, reads it into sbrk memory, and lexes it —
//   the first time this scanner touches N it did not carry as a
//   literal. Design finding, kept honest: N cannot build a `str` from a
//   pointer + length (no constructor — an owning string is n++
//   territory), so the file scanner walks the raw buffer with p[i]
//   pointer reads instead of s[i]... which is exactly what ncc's own
//   lexer does with its SRC pointer. The limitation pushed the toy
//   toward the real shape.
//   When this scanner grows a parser and a C emitter, ncc self-hosts.

#[caps(syscall)]
extern syscall {
    fn write(fd: i32, buf: #[user] *u8, len: isize) -> i64 = 1
    fn sys_open(path: *u8, flags: i64, mode: i64) -> i64   = 3
    fn sys_read(fd: i64, buf: *u8, len: isize) -> i64      = 4
    fn sys_close(fd: i64) -> i64                           = 5
    fn sys_sbrk(incr: i64) -> i64                          = 7
}

#[caps(syscall)]
fn put(s: str) {
    write(1, s.ptr as #[user] *u8, s.len as isize);
}

// Write s[start .. start+len): the explicit addr cast is N's only pointer
// arithmetic, and #[user] marks the kernel handoff — both boundaries visible.
#[caps(syscall)]
fn put_span(s: str, start: i64, len: i64) {
    write(1, (s.ptr as addr + start as addr) as #[user] *u8, len as isize);
}

enum Kind { Kw, Ident, Num, Str, Cmnt, Op, Punct }

fn label(k: Kind) -> str {
    return match k {
        Kw    => "kw    ",
        Ident => "ident ",
        Num   => "num   ",
        Str   => "str   ",
        Cmnt  => "cmnt  ",
        Op    => "op    ",
        Punct => "punct ",
    };
}

fn emit(k: Kind, s: str, start: i64, len: i64) {
    put(label(k));
    put_span(s, start, len);
    put("\n");
}

fn is_space(b: i64) -> bool { b == 32 || b == 9 || b == 10 }
fn is_digit(b: i64) -> bool { b >= 48 && b <= 57 }
fn is_alpha(b: i64) -> bool {
    (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95
}
fn is_alnum(b: i64) -> bool { is_alpha(b) || is_digit(b) }

// The two-character operator table, as byte pairs: := -> == != <= >= .. += -=
fn is_op2(a: i64, b: i64) -> bool {
    if a == 58 && b == 61 { return true; }   // :=
    if a == 45 && b == 62 { return true; }   // ->
    if a == 61 && b == 61 { return true; }   // ==
    if a == 33 && b == 61 { return true; }   // !=
    if a == 60 && b == 61 { return true; }   // <=
    if a == 62 && b == 61 { return true; }   // >=
    if a == 46 && b == 46 { return true; }   // ..
    if a == 43 && b == 61 { return true; }   // +=
    if a == 45 && b == 61 { return true; }   // -=
    false
}

// Byte-wise comparison of s[start .. start+len) against a keyword.
fn span_is(s: str, start: i64, len: i64, kw: str) -> bool {
    if len != kw.len as i64 {
        return false;
    }
    for k in 0..len {
        if s[start + k] as i64 != kw[k] as i64 {
            return false;
        }
    }
    true
}

fn is_kw(s: str, start: i64, len: i64) -> bool {
    if span_is(s, start, len, "fn")     { return true; }
    if span_is(s, start, len, "mut")    { return true; }
    if span_is(s, start, len, "return") { return true; }
    if span_is(s, start, len, "if")     { return true; }
    if span_is(s, start, len, "else")   { return true; }
    if span_is(s, start, len, "while")  { return true; }
    if span_is(s, start, len, "for")    { return true; }
    if span_is(s, start, len, "in")     { return true; }
    if span_is(s, start, len, "own")    { return true; }
    false
}

// The buffer twins: file bytes live behind a *u8 (N has no way to wrap
// a pointer + length back into a str), so the file path re-implements
// the span compare over p[i] reads — the same walk ncc does over SRC.
fn bspan_is(p: *u8, start: i64, len: i64, kw: str) -> bool {
    if len != kw.len as i64 {
        return false;
    }
    for k in 0..len {
        if p[start + k] as i64 != kw[k] as i64 {
            return false;
        }
    }
    true
}

fn is_kw_buf(p: *u8, start: i64, len: i64) -> bool {
    if bspan_is(p, start, len, "fn")     { return true; }
    if bspan_is(p, start, len, "mut")    { return true; }
    if bspan_is(p, start, len, "return") { return true; }
    if bspan_is(p, start, len, "if")     { return true; }
    if bspan_is(p, start, len, "else")   { return true; }
    if bspan_is(p, start, len, "while")  { return true; }
    if bspan_is(p, start, len, "for")    { return true; }
    if bspan_is(p, start, len, "in")     { return true; }
    if bspan_is(p, start, len, "own")    { return true; }
    false
}

// Lex n bytes of N source sitting behind p; print per-kind counts.
// Same decisions as the embedded demo's scanner, over pointer reads.
fn lex_count(p: *u8, n: i64) {
    mut kw := 0; mut ident := 0; mut num := 0; mut lit := 0;
    mut cmnt := 0; mut op := 0; mut punct := 0;
    mut i := 0;
    while i < n {
        b := p[i] as i64;
        if is_space(b) || b == 13 {
            i += 1;
            continue;
        }
        if b == 47 && i + 1 < n && p[i + 1] as i64 == 47 {
            while i < n && p[i] as i64 != 10 {
                i += 1;
            }
            cmnt += 1;
            continue;
        }
        if b == 34 {
            mut j := i + 1;
            while j < n && p[j] as i64 != 34 {
                if p[j] as i64 == 92 { j += 2; } else { j += 1; }
            }
            lit += 1;
            i = j + 1;
            continue;
        }
        if is_digit(b) {
            while i < n && is_digit(p[i] as i64) {
                i += 1;
            }
            num += 1;
            continue;
        }
        if is_alpha(b) {
            st := i;
            mut j := i;
            while j < n && is_alnum(p[j] as i64) {
                j += 1;
            }
            if is_kw_buf(p, st, j - st) { kw += 1; } else { ident += 1; }
            i = j;
            continue;
        }
        if i + 1 < n && is_op2(b, p[i + 1] as i64) {
            op += 1;
            i += 2;
            continue;
        }
        punct += 1;
        i += 1;
    }
    total := kw + ident + num + lit + cmnt + op + punct;
    put("{total} tokens: {kw} kw, {ident} ident, {num} num, {lit} str, {cmnt} cmnt, {op} op, {punct} punct\n");
}

fn main() -> i64 {
    // Braces and quotes are escaped so they read as text (§2.5) — the
    // snippet exercises a comment, ->, :=, >=, and a string literal.
    src := "// twice, with a guard\nfn twice(x: i64) -> i64 \{ s := \"two\"; if x >= 0 \{ return x * 2 \} 0 \}";
    put("tokens:\n");
    n := src.len as i64;
    mut i := 0;
    while i < n {
        b := src[i] as i64;
        if is_space(b) {
            i += 1;
            continue;
        }
        if b == 47 && i + 1 < n && src[i + 1] as i64 == 47 {
            mut j := i;                   // line comment: runs to end of line
            while j < n && src[j] as i64 != 10 {
                j += 1;
            }
            emit(Kind.Cmnt, src, i, j - i);
            i = j;
            continue;
        }
        if b == 34 {
            mut j := i + 1;               // string literal: a backslash always
            while j < n && src[j] as i64 != 34 {
                if src[j] as i64 == 92 {  // escapes the next byte, so \" cannot
                    j += 2;               // close the scan early
                } else {
                    j += 1;
                }
            }
            emit(Kind.Str, src, i, j + 1 - i);
            i = j + 1;
            continue;
        }
        if is_digit(b) {
            mut j := i;
            while j < n && is_digit(src[j] as i64) {
                j += 1;
            }
            emit(Kind.Num, src, i, j - i);
            i = j;
            continue;
        }
        if is_alpha(b) {
            mut j := i;
            while j < n && is_alnum(src[j] as i64) {
                j += 1;
            }
            if is_kw(src, i, j - i) {
                emit(Kind.Kw, src, i, j - i);
            } else {
                emit(Kind.Ident, src, i, j - i);
            }
            i = j;
            continue;
        }
        if i + 1 < n && is_op2(b, src[i + 1] as i64) {
            emit(Kind.Op, src, i, 2);
            i += 2;
            continue;
        }
        emit(Kind.Punct, src, i, 1);      // single-char punctuation
        i += 1;
    }
    // Rung 1 of the selfhost road: lex N source THIS PROGRAM DID NOT
    // EMBED — a real .n file, read from disk into sbrk memory. (The
    // in-OS copy of this file reads /mnt/n_lex_demo.n instead.)
    lex_file("/tmp/n_lex_demo.n");
    0
}

// The audited boundary for the file demo: opening, reading and closing
// are kernel crossings, so they live in one capability-holding wrapper.
#[caps(syscall)]
fn lex_file(path: str) {
    fd := sys_open(path.ptr as *u8, 0, 0);
    if fd < 0 {
        put("(no lex demo file - file demo skipped)\n");
        return;
    }
    buf := sys_sbrk(4096) as *u8;
    len := sys_read(fd, buf, 4096);
    sys_close(fd);
    if len > 0 {
        put("lexing hello.n from disk: ");
        lex_count(buf, len);
    }
}
