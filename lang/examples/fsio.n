// fsio.n — the N++ P3 standard-bindings sketch: fs wrappers over raw
// syscalls that convert the kernel's negative-return convention into
// result enums ONCE, at the boundary — so application code never checks
// sign bits, it just writes `?` chains (design-npp.md §2.2, realized).
//
//   - fs_open wraps sys_open:  FdResult  (Ok carries the fd)
//   - cat     composes:        IoResult  (Ok carries bytes copied)
//   - fs_open's FdResult rewraps into cat's IoResult through `?`
//   - defer closes the fd on every exit path, including propagation
//   - the read buffer comes from sys_sbrk — N has no address-of operator,
//     so buffers are runtime-provided memory, by design
//
// N has no modules yet, so the bindings live in the same file as their
// caller; when `use` lands they move to a std library unchanged.
//
// Error numbers are platform-specific: NyxOS syscalls return a bare -1,
// the Linux host shim returns -errno (e.g. -2 ENOENT). The bindings
// capture whatever arrives; only the printed number differs per platform.

extern syscall {
    fn sys_open(path: *u8, flags: i64, mode: i64) -> i64 = 3
    fn sys_read(fd: i64, buf: *u8, len: isize) -> i64    = 4
    fn sys_close(fd: i64) -> i64                         = 5
    fn sys_sbrk(incr: i64) -> i64                        = 7
    fn write(fd: i32, buf: *u8, len: isize) -> i64       = 1
}

fn put(s: str) {
    write(1, s.ptr as *u8, s.len as isize);
}

enum FdResult { Ok(fd: i64), Err(errno: i64) }
enum IoResult { Ok(n: i64),  Err(errno: i64) }

// The boundary: negative return becomes Err exactly once, right here.
// str literals lower to NUL-terminated C literals, so .ptr is a valid path.
fn fs_open(path: str) -> FdResult {
    fd := sys_open(path.ptr as *u8, 0, 0);
    if fd < 0 {
        return FdResult.Err{ errno: -fd };
    }
    FdResult.Ok{ fd: fd }
}

// Copy a whole file to stdout. FdResult.Err rewraps into IoResult.Err at
// the `?` (both Err payloads are i64); the deferred close runs on the
// success path AND on every propagating return after the fd exists.
fn cat(path: str) -> IoResult {
    fd := fs_open(path)?;
    defer sys_close(fd);
    buf := sys_sbrk(4096) as *u8;
    mut total := 0;
    mut n := sys_read(fd, buf, 4096);
    while n > 0 {
        write(1, buf, n as isize);
        total += n;
        n = sys_read(fd, buf, 4096);
    }
    if n < 0 {
        return IoResult.Err{ errno: -n };
    }
    IoResult.Ok{ n: total }
}

fn main() -> i64 {
    match cat("/tmp/n_bindings_demo.txt") {
        Ok(n)      => { put("-- read {n} bytes\n"); },
        Err(errno) => { put("cat failed (errno {errno})\n"); },
    }
    match cat("/no/such/file") {
        Ok(n)      => { put("unexpected success: {n}\n"); },
        Err(errno) => { put("missing file rejected (errno {errno})\n"); },
    }
    0
}
