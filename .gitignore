*.zip

# === QEMU / test logs ===
*.log
*.tmp
wget-log*

# === IDE ===
.vscode/
.idea/
.claude/
*.swp
*.swo
*~

# === Secrets / credentials (NEVER commit — keep keys in environment variables) ===
# API keys, tokens (GitHub PATs), passwords and private keys must live in the
# environment, never in the source tree. These patterns keep them out of git.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_ed25519
*.ppk
.netrc
_netrc
.git-credentials
secrets.*
*.secret
credentials.json
*.credentials

# === Initramfs ===
initramfs/
# Generated every build by tools/mkinitramfs.py from the (untracked) user/*.elf + *.so.
# It was tracked, but the current toolchain rebuilds it byte-differently from the committed
# copy, so every clean build showed a ~27k-line churn. It's a second-order build artifact
# (like the *.elf it embeds, already ignored above) — regenerated from a clean checkout by
# the Makefile's `fs/initramfs_data.h` rule, so nothing needs it in git.
kernel/fs/initramfs_data.h

