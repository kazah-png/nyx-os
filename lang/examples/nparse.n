// nparse.n — the M5 chain, token-native end to end: lex → parse → emit → run.
//   ntokens.n scans N source and ncalc.n evaluates expressions, but each
//   worked alone: ncalc re-reads raw characters inside its grammar. Real
//   compilers do not — the lexer runs first, the parser consumes its
//   TOKEN STREAM, and the output is CODE, not a value:
//     source str ──lex()──► kinds[] / vals[] (sbrk'd i64 buffers,
//     written with v0.16 index stores) ──parse──► stack code ──run──► value
//   The parser never touches a character and never computes a result:
//   each grammar rule EMITS opcodes as it recognizes its shape (postfix
//   order falls out of the descent, exactly like ncc's own gen_expr),
//   and an inline VM — nstack's machine plus three comparison opcodes —
//   executes the emitted program. State rides return values in the
//   EP{pos,cp} pair (token position, code position): N has no globals,
//   so both cursors thread functionally through every rule.
//   On top of ncalc's grammar: identifiers (a one-letter environment:
//   x=10, y=4, folded to constants at emit time) and comparisons
//   < > ==, one precedence level below + and -.
//   Token encoding: kind 0 = number (val = its value), 1 = identifier
//   (val = environment index), 2 = operator/paren (val = its byte),
//   3 = the two-char operator '==', 9 = end of input.
//   Opcodes: 0 HALT · 1 PUSH arg · 2 ADD · 3 SUB · 4 MUL · 5 DIV ·
//   6 MOD · 7 NEG · 8 LT · 9 GT · 10 EQ (comparisons push 0 or 1).

#[caps(syscall)]
extern syscall {
    fn write(fd: i32, buf: #[user] *u8, len: isize) -> i64 = 1
    fn sys_sbrk(incr: i64) -> i64                          = 7
}

#[caps(syscall)]
fn put(s: str) {
    write(1, s.ptr as #[user] *u8, s.len as isize);
}

#[caps(syscall)]
fn alloc_words(n: i64) -> *i64 {
    sys_sbrk(n * 8) as *i64
}

fn is_digit(b: i64) -> bool { b >= 48 && b <= 57 }

// The fixed environment: x = 10, y = 4.
fn env(id: i64) -> i64 {
    if id == 0 {
        return 10;
    }
    4
}

// Scan src into the two token arrays; returns the token count. The
// last token is always the end marker (kind 9), so the parser can
// stop without carrying the count around.
fn lex(src: str, k: *i64, v: *i64) -> i64 {
    n := src.len as i64;
    mut i := 0;
    mut t := 0;
    while i < n {
        b := src[i] as i64;
        if b == 32 {                       // space
            i += 1;
            continue;
        }
        if is_digit(b) {
            mut val := 0;
            while i < n && is_digit(src[i] as i64) {
                val = val * 10 + (src[i] as i64 - 48);
                i += 1;
            }
            k[t] = 0; v[t] = val; t += 1;
            continue;
        }
        if b == 120 || b == 121 {          // x | y — the environment
            k[t] = 1;
            if b == 120 { v[t] = 0; } else { v[t] = 1; }
            t += 1;
            i += 1;
            continue;
        }
        if b == 61 && i + 1 < n && src[i + 1] as i64 == 61 {
            k[t] = 3; v[t] = 0; t += 1;    // ==
            i += 2;
            continue;
        }
        k[t] = 2; v[t] = b; t += 1;        // operator / paren, by byte
        i += 1;
    }
    k[t] = 9; v[t] = 0;                    // end marker
    t + 1
}

// Both cursors, threaded functionally: pos walks tokens, cp walks code.
struct EP { pos: i64, cp: i64 }

fn emit1(code: *i64, cp: i64, op: i64) -> i64 {
    code[cp] = op;
    cp + 1
}

fn emit2(code: *i64, cp: i64, op: i64, arg: i64) -> i64 {
    code[cp] = op;
    code[cp + 1] = arg;
    cp + 2
}

// factor := number | ident | '-' factor | '(' cmp ')'
fn parse_factor(k: *i64, v: *i64, pos: i64, code: *i64, cp: i64) -> EP {
    if k[pos] == 0 {
        return EP{ pos: pos + 1, cp: emit2(code, cp, 1, v[pos]) };
    }
    if k[pos] == 1 {                       // ident: fold env to a constant
        return EP{ pos: pos + 1, cp: emit2(code, cp, 1, env(v[pos])) };
    }
    if k[pos] == 2 && v[pos] == 45 {       // unary minus: operand, then NEG
        r := parse_factor(k, v, pos + 1, code, cp);
        return EP{ pos: r.pos, cp: emit1(code, r.cp, 7) };
    }
    r := parse_cmp(k, v, pos + 1, code, cp);   // '(' — mutual recursion
    EP{ pos: r.pos + 1, cp: r.cp }             // skip ')'
}

// term := factor (('*' | '/' | '%') factor)*  — op emitted after its rhs
fn parse_term(k: *i64, v: *i64, pos: i64, code: *i64, cp: i64) -> EP {
    mut r := parse_factor(k, v, pos, code, cp);
    mut going := true;
    while going {
        going = false;
        if k[r.pos] == 2 && (v[r.pos] == 42 || v[r.pos] == 47 || v[r.pos] == 37) {
            op := v[r.pos];
            n := parse_factor(k, v, r.pos + 1, code, r.cp);
            mut oc := 4;                   // MUL
            if op == 47 { oc = 5; }        // DIV
            if op == 37 { oc = 6; }        // MOD
            r = EP{ pos: n.pos, cp: emit1(code, n.cp, oc) };
            going = true;
        }
    }
    r
}

// sum := term (('+' | '-') term)*
fn parse_sum(k: *i64, v: *i64, pos: i64, code: *i64, cp: i64) -> EP {
    mut r := parse_term(k, v, pos, code, cp);
    mut going := true;
    while going {
        going = false;
        if k[r.pos] == 2 && (v[r.pos] == 43 || v[r.pos] == 45) {
            op := v[r.pos];
            n := parse_term(k, v, r.pos + 1, code, r.cp);
            mut oc := 2;                   // ADD
            if op == 45 { oc = 3; }        // SUB
            r = EP{ pos: n.pos, cp: emit1(code, n.cp, oc) };
            going = true;
        }
    }
    r
}

// cmp := sum [('<' | '>' | '==') sum]   — lowest tier, pushes 0 or 1
fn parse_cmp(k: *i64, v: *i64, pos: i64, code: *i64, cp: i64) -> EP {
    l := parse_sum(k, v, pos, code, cp);
    two := k[l.pos] == 3;
    one := k[l.pos] == 2 && (v[l.pos] == 60 || v[l.pos] == 62);
    if two || one {
        mut oc := 10;                      // EQ
        if one && v[l.pos] == 60 { oc = 8; }   // LT
        if one && v[l.pos] == 62 { oc = 9; }   // GT
        r := parse_sum(k, v, l.pos + 1, code, l.cp);
        return EP{ pos: r.pos, cp: emit1(code, r.cp, oc) };
    }
    l
}

// nstack's machine, grown three comparison opcodes.
fn run(prog: *i64, stk: *i64) -> i64 {
    mut pc := 0;
    mut sp := 0;
    mut running := true;
    while running {
        op := prog[pc];
        if op == 0 { running = false; }
        if op == 1 { stk[sp] = prog[pc + 1]; sp += 1; pc += 2; }
        if op == 2 { stk[sp - 2] = stk[sp - 2] + stk[sp - 1]; sp -= 1; pc += 1; }
        if op == 3 { stk[sp - 2] = stk[sp - 2] - stk[sp - 1]; sp -= 1; pc += 1; }
        if op == 4 { stk[sp - 2] = stk[sp - 2] * stk[sp - 1]; sp -= 1; pc += 1; }
        if op == 5 { stk[sp - 2] = stk[sp - 2] / stk[sp - 1]; sp -= 1; pc += 1; }
        if op == 6 { stk[sp - 2] = stk[sp - 2] % stk[sp - 1]; sp -= 1; pc += 1; }
        if op == 7 { stk[sp - 1] = -stk[sp - 1]; pc += 1; }
        if op == 8 {
            mut t := 0;
            if stk[sp - 2] < stk[sp - 1] { t = 1; }
            stk[sp - 2] = t; sp -= 1; pc += 1;
        }
        if op == 9 {
            mut t := 0;
            if stk[sp - 2] > stk[sp - 1] { t = 1; }
            stk[sp - 2] = t; sp -= 1; pc += 1;
        }
        if op == 10 {
            mut t := 0;
            if stk[sp - 2] == stk[sp - 1] { t = 1; }
            stk[sp - 2] = t; sp -= 1; pc += 1;
        }
    }
    stk[0]
}

// The whole pipeline in one call: tokens in, code out, value from the VM.
fn show(src: str, k: *i64, v: *i64, code: *i64, stk: *i64) {
    lex(src, k, v);
    r := parse_cmp(k, v, 0, code, 0);
    words := emit1(code, r.cp, 0);         // HALT closes the program
    val := run(code, stk);
    put("{src}  ->  {val}   [{words} code words]\n");
}

fn main() -> i64 {
    k := alloc_words(64);
    v := alloc_words(64);
    code := alloc_words(64);
    stk := alloc_words(64);
    put("lex -> parse -> emit -> run, with x=10, y=4:\n");
    show("2 + x * y", k, v, code, stk);
    show("(2 + x) * y", k, v, code, stk);
    show("x * y == 40", k, v, code, stk);
    show("x - y < 5", k, v, code, stk);
    0
}
