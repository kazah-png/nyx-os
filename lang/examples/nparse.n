// nparse.n — the M5 chain, token-native end to end: a complete toy
//   compiler with FUNCTIONS, REAL IDENTIFIERS, and — since the selfhost
//   road's rung 3 — a real AST for its expressions, with a real CHECK
//   PASS over it. lex → parse → check → emit → run, in N's own syntax:
//       fn fact(n) { r := 1; if n > 1 { r := n * fact(n - 1); } r } fact(5)
//   The lexer fills a token buffer (sbrk'd i64 arrays, v0.16 index
//   stores); the parser consumes TOKENS, never characters; the VM runs
//   the emitted stack code. The grammar covers the whole toy language:
//     program := { fndef } { stmt } cmp
//     fndef   := 'fn' name '(' name { ',' name } ')' '{' { stmt } cmp '}'
//     stmt    := name ':=' cmp ';'
//              | 'if' cmp block [ 'else' block ]
//              | 'while' cmp block
//
//   THE EXPRESSION TIER IS TWO-PHASE NOW. The old parser emitted code
//   while it descended — postfix fell out of parse order, which works
//   exactly as long as nothing needs to happen between understanding
//   the program and generating its code. A checker is precisely that
//   kind of thing: it must look at a whole expression BEFORE code for
//   it exists, which is why ncc parses to Expr/Stmt trees first and an
//   emit-on-the-fly toy never could. So the expression rules now BUILD
//   a postorder AST: parallel i64 node arrays carried in one struct
//   (Ast — nk kind, nl lhs, nr rhs, nv value, and na, a flat argument
//   table with four slots per call node: the fp[f*4+j] move again).
//     node kind 0 = number (nv = value)     1 = load (nv = var slot)
//               2 = binop (nl/nr = children, nv = ITS VM OPCODE)
//               3 = negate (nl = operand)
//               4 = call (nv = fn symbol, nl = arg count, args in na)
//   A separate walker, emit_node, then emits by postorder recursion —
//   children first, the node's own operation last. Postfix is no
//   longer a lucky consequence of parse order; it is a property of the
//   tree, and the walker produces byte-for-byte the code the emitting
//   parser used to, so every result and word count below is unchanged:
//   the architecture moved under the outputs. The caller-save call
//   machinery (save the callee's slots in order, evaluate ALL the
//   arguments before binding any — so `gcd(b, a % b)` still reads the
//   OLD values — bind in REVERSE because pops hand back the last
//   argument first, CALL, restore in reverse with SWAP + STORE) moved
//   wholesale from the parser into the walker: parse decides WHAT (a
//   call of f with these argument trees), emit decides HOW — ncc's own
//   parse → gen split, now inside the toy. And the first dividend of
//   holding a whole call as data: the parser checks the argument count
//   against the callee's parameter count ("wrong number of
//   arguments"), a diagnostic the fused version had no natural seat
//   for. Statements and control flow still emit directly — the jump
//   patching (`if`/`else` diamond, `while` back-JMP) is unchanged, and
//   folding statements into the tree is a later rung; the seam between
//   the tiers is one function, gen_cmp: build a fresh expression tree,
//   CHECK it, walk it, hand back the cursors the old parse_cmp did.
//
//   THE CHECK PASS is the payoff the AST exists for. Between build and
//   emit, check_node walks the finished tree — it reads the program
//   and emits nothing — and rejects any load of a name that is not in
//   the BOUND SET: the enclosing function's parameters plus the names
//   bound by `:=` statements already compiled. Every node records its
//   source line (nline, the sixth Ast array), so the refusal is
//   located: "line N: error: unknown variable". Scope is honest and
//   conservative: the bound set is a list plus a count threaded with
//   the other cursors, a block SNAPSHOTS the count at its '\{' and
//   restores it at its '\}' — a binding made inside an `if` arm or a
//   `while` body dies with the arm, because the checker cannot know
//   the branch will have run (the same conservative rule ncc's v0.18
//   own-move branch merge enforces, here in miniature). A function
//   body sees ONLY its parameters and its own bindings: the flat
//   runtime table lets bodies read anything, but that is caller-save's
//   private business, and the checker now enforces the lexical story.
//
//   Everything below the seam is as the earlier rungs left it.
//   Identifiers are INTERNED (a names byte-buffer plus per-symbol
//   start/len; the token's value IS the symbol index, and slots,
//   function entries and parameter tables key off it). Every token
//   records its source line, and the parser refuses bad input at its
//   expect points — "line N: error: ..." and stop, first violation
//   wins. Function entries are recorded BEFORE bodies compile, so
//   self-recursion resolves; a JMP patched over the fndefs starts
//   execution at the main statements.
//   Token encoding: kind 0 = number (val = its value), 1 = identifier
//   (val = its SYMBOL INDEX), 2 = operator/punct (val = its byte),
//   3 = '==', 4 = ':=', 5 = 'if', 6 = 'while', 7 = 'fn', 8 = 'else',
//   9 = end.
//   Opcodes: 0 HALT · 1 PUSH arg · 2 ADD · 3 SUB · 4 MUL · 5 DIV ·
//   6 MOD · 7 NEG · 8 LT · 9 GT · 10 EQ · 11 LOAD slot · 12 STORE slot
//   · 13 JZ target · 14 JMP target · 15 CALL target (pushes the return
//   address) · 16 RET (returns the top value) · 17 SWAP.

#[caps(syscall)]
extern syscall {
    fn write(fd: i32, buf: #[user] *u8, len: isize) -> i64 = 1
    fn sys_sbrk(incr: i64) -> i64                          = 7
    fn sys_exit(code: i64) -> never                        = 0
}

#[caps(syscall)]
fn put(s: str) {
    write(1, s.ptr as #[user] *u8, s.len as isize);
}

#[caps(syscall)]
fn alloc_words(n: i64) -> *i64 {
    sys_sbrk(n * 8) as *i64
}

#[caps(syscall)]
fn alloc_bytes(n: i64) -> *u8 {
    sys_sbrk(n) as *u8
}

fn is_digit(b: i64) -> bool { b >= 48 && b <= 57 }
fn is_letter(b: i64) -> bool { b >= 97 && b <= 122 }

// Scan src into the two token arrays; returns the token count. The
// last token is always the end marker (kind 9), so the parser can
// stop without carrying the count around. Identifiers intern into the
// symbol table (nb = names bytes, ss/sl = per-symbol start/len): a
// span already seen yields its existing index, a new one is appended —
// the same move ncc's vars_find/vars_add makes over its VARS table.
fn lex(src: str, k: *i64, v: *i64, ln: *i64, nb: *u8, ss: *i64, sl: *i64) -> i64 {
    n := src.len as i64;
    mut i := 0;
    mut t := 0;
    mut ns := 0;                           // interned symbol count
    mut nl := 0;                           // names buffer length
    mut line := 1;                         // 1-based, for diagnostics (rung 2)
    while i < n {
        b := src[i] as i64;
        if b == 32 || b == 9 || b == 13 {  // space / tab / CR
            i += 1;
            continue;
        }
        if b == 10 {                       // newline: the diagnostic counter
            line += 1;
            i += 1;
            continue;
        }
        ln[t] = line;                      // every token records its line
        if is_digit(b) {
            mut val := 0;
            while i < n && is_digit(src[i] as i64) {
                val = val * 10 + (src[i] as i64 - 48);
                i += 1;
            }
            k[t] = 0; v[t] = val; t += 1;
            continue;
        }
        if is_letter(b) {                  // keyword or identifier
            st := i;
            mut j := i;
            while j < n && is_letter(src[j] as i64) {
                j += 1;
            }
            len := j - st;
            mut kind := 1;
            if len == 2 && src[st] as i64 == 105 && src[st + 1] as i64 == 102 {
                kind = 5;                  // if
            }
            if len == 2 && src[st] as i64 == 102 && src[st + 1] as i64 == 110 {
                kind = 7;                  // fn
            }
            if len == 5 && src[st] as i64 == 119 && src[st + 1] as i64 == 104
                && src[st + 2] as i64 == 105 && src[st + 3] as i64 == 108
                && src[st + 4] as i64 == 101 {
                kind = 6;                  // while
            }
            if len == 4 && src[st] as i64 == 101 && src[st + 1] as i64 == 108
                && src[st + 2] as i64 == 115 && src[st + 3] as i64 == 101 {
                kind = 8;                  // else
            }
            mut val := 0;
            if kind == 1 {                 // intern: look the span up ...
                mut idx := -1;
                mut s := 0;
                while s < ns {
                    if sl[s] == len {
                        mut eq := true;
                        mut q := 0;
                        while q < len {
                            if nb[ss[s] + q] as i64 != src[st + q] as i64 {
                                eq = false;
                            }
                            q += 1;
                        }
                        if eq && idx < 0 { idx = s; }
                    }
                    s += 1;
                }
                if idx < 0 {               // ... or append a new symbol
                    ss[ns] = nl;
                    sl[ns] = len;
                    mut q := 0;
                    while q < len {
                        nb[nl + q] = src[st + q];
                        q += 1;
                    }
                    nl += len;
                    idx = ns;
                    ns += 1;
                }
                val = idx;
            }
            k[t] = kind; v[t] = val; t += 1;
            i = j;
            continue;
        }
        if b == 58 && i + 1 < n && src[i + 1] as i64 == 61 {
            k[t] = 4; v[t] = 0; t += 1;    // :=
            i += 2;
            continue;
        }
        if b == 61 && i + 1 < n && src[i + 1] as i64 == 61 {
            k[t] = 3; v[t] = 0; t += 1;    // ==
            i += 2;
            continue;
        }
        k[t] = 2; v[t] = b; t += 1;        // operator / punct, by byte
        i += 1;
    }
    k[t] = 9; v[t] = 0; ln[t] = line;      // end marker
    t + 1
}

// Rung 2 of the selfhost road: the toy REFUSES bad input instead of
// wandering into undefined behavior. First error wins; the message
// carries the token's source line. (It exits with status 0 so the test
// harness — which treats a non-zero exit as an example crash — stays
// strict for everything else; a real compiler would exit 1.)
#[caps(syscall)]
fn fail(line: i64, msg: str) -> never {
    put("line {line}: error: {msg}\n");
    sys_exit(0);
}

// The expression tree, as parallel i64 arrays in one by-value struct:
// nk = node kind, nl/nr = child indexes, nv = the node's value (a
// number, a slot, an opcode, or a function symbol), na = the flat
// argument table (four root indexes per call node, na[idx*4 + j]),
// nline = the node's source line, so the check pass can locate blame.
struct Ast { nk: *i64, nl: *i64, nr: *i64, nv: *i64, na: *i64, nline: *i64 }

// The statement tier's cursors, threaded functionally: pos walks
// tokens, cp walks code, bc is the bound-name count — how much of the
// bound list is live in this scope (blocks restore it at their '}').
struct EP { pos: i64, cp: i64, bc: i64 }

// The build-phase cursors: pos walks tokens, nn is the next free node,
// root is the subtree this rule just built.
struct NP { pos: i64, nn: i64, root: i64 }

fn emit1(code: *i64, cp: i64, op: i64) -> i64 {
    code[cp] = op;
    cp + 1
}

fn emit2(code: *i64, cp: i64, op: i64, arg: i64) -> i64 {
    code[cp] = op;
    code[cp + 1] = arg;
    cp + 2
}

// factor := number | name '(' cmp { ',' cmp } ')' | name
//         | '-' factor | '(' cmp ')'
//   Phase one only BUILDS: every arm appends a node and returns its
//   index — not a single opcode is emitted on this side of the seam.
//   The call arm allocates its node FIRST so the argument roots can
//   fill its slice of the arg table in place; and with the whole call
//   in hand as data, the parser finally checks it — the argument count
//   must match the callee's parameter count.
fn ast_factor(k: *i64, v: *i64, ln: *i64, fpc: *i64, a: Ast, pos: i64, nn: i64) -> NP {
    if k[pos] == 0 {                       // number
        a.nk[nn] = 0; a.nl[nn] = 0; a.nr[nn] = 0; a.nv[nn] = v[pos];
        a.nline[nn] = ln[pos];
        return NP{ pos: pos + 1, nn: nn + 1, root: nn };
    }
    if k[pos] == 1 && k[pos + 1] == 2 && v[pos + 1] == 40 {
        f := v[pos];                       // name '(' — a call
        idx := nn;                         // the call node, made first
        a.nline[idx] = ln[pos];
        mut n2 := nn + 1;
        mut p := pos + 2;
        mut cnt := 0;
        mut more := !(k[p] == 2 && v[p] == 41);
        while more {                       // comma-separated argument trees
            more = false;
            r := ast_cmp(k, v, ln, fpc, a, p, n2);
            if cnt == 4 {                  // the arg table holds four
                fail(ln[p], "wrong number of arguments");
            }
            a.na[idx * 4 + cnt] = r.root;
            cnt += 1;
            p = r.pos;
            n2 = r.nn;
            if k[p] == 2 && v[p] == 44 {   // ',' — another argument
                p += 1;
                more = true;
            }
        }
        if !(k[p] == 2 && v[p] == 41) {
            fail(ln[p], "expected ')' after the arguments");
        }
        if cnt != fpc[f] {                 // the first check that reads a call
            fail(ln[p], "wrong number of arguments");
        }
        a.nk[idx] = 4; a.nl[idx] = cnt; a.nr[idx] = 0; a.nv[idx] = f;
        return NP{ pos: p + 1, nn: n2, root: idx };
    }
    if k[pos] == 1 {                       // name read
        a.nk[nn] = 1; a.nl[nn] = 0; a.nr[nn] = 0; a.nv[nn] = v[pos];
        a.nline[nn] = ln[pos];
        return NP{ pos: pos + 1, nn: nn + 1, root: nn };
    }
    if k[pos] == 2 && v[pos] == 45 {       // unary minus
        r := ast_factor(k, v, ln, fpc, a, pos + 1, nn);
        a.nk[r.nn] = 3; a.nl[r.nn] = r.root; a.nr[r.nn] = 0; a.nv[r.nn] = 0;
        a.nline[r.nn] = ln[pos];
        return NP{ pos: r.pos, nn: r.nn + 1, root: r.nn };
    }
    if k[pos] == 2 && v[pos] == 40 {       // '(' — mutual recursion
        r := ast_cmp(k, v, ln, fpc, a, pos + 1, nn);
        if !(k[r.pos] == 2 && v[r.pos] == 41) {
            fail(ln[r.pos], "expected ')'");
        }
        return NP{ pos: r.pos + 1, nn: r.nn, root: r.root };
    }
    fail(ln[pos], "expected an expression");
    NP{ pos: pos, nn: nn, root: 0 }        // unreachable; keeps the lowering total
}

// term := factor (('*' | '/' | '%') factor)*
//   The operator tag stored in a binop node IS its VM opcode — one
//   name for one thing, so the walker emits nv directly.
fn ast_term(k: *i64, v: *i64, ln: *i64, fpc: *i64, a: Ast, pos: i64, nn: i64) -> NP {
    mut r := ast_factor(k, v, ln, fpc, a, pos, nn);
    mut going := true;
    while going {
        going = false;
        if k[r.pos] == 2 && (v[r.pos] == 42 || v[r.pos] == 47 || v[r.pos] == 37) {
            op := v[r.pos];
            opl := ln[r.pos];
            n := ast_factor(k, v, ln, fpc, a, r.pos + 1, r.nn);
            mut oc := 4;                   // MUL
            if op == 47 { oc = 5; }        // DIV
            if op == 37 { oc = 6; }        // MOD
            a.nk[n.nn] = 2; a.nl[n.nn] = r.root; a.nr[n.nn] = n.root; a.nv[n.nn] = oc;
            a.nline[n.nn] = opl;
            r = NP{ pos: n.pos, nn: n.nn + 1, root: n.nn };
            going = true;
        }
    }
    r
}

// sum := term (('+' | '-') term)*
fn ast_sum(k: *i64, v: *i64, ln: *i64, fpc: *i64, a: Ast, pos: i64, nn: i64) -> NP {
    mut r := ast_term(k, v, ln, fpc, a, pos, nn);
    mut going := true;
    while going {
        going = false;
        if k[r.pos] == 2 && (v[r.pos] == 43 || v[r.pos] == 45) {
            op := v[r.pos];
            opl := ln[r.pos];
            n := ast_term(k, v, ln, fpc, a, r.pos + 1, r.nn);
            mut oc := 2;                   // ADD
            if op == 45 { oc = 3; }        // SUB
            a.nk[n.nn] = 2; a.nl[n.nn] = r.root; a.nr[n.nn] = n.root; a.nv[n.nn] = oc;
            a.nline[n.nn] = opl;
            r = NP{ pos: n.pos, nn: n.nn + 1, root: n.nn };
            going = true;
        }
    }
    r
}

// cmp := sum [('<' | '>' | '==') sum]   — lowest tier, pushes 0 or 1
fn ast_cmp(k: *i64, v: *i64, ln: *i64, fpc: *i64, a: Ast, pos: i64, nn: i64) -> NP {
    l := ast_sum(k, v, ln, fpc, a, pos, nn);
    two := k[l.pos] == 3;
    one := k[l.pos] == 2 && (v[l.pos] == 60 || v[l.pos] == 62);
    if two || one {
        mut oc := 10;                      // EQ
        if one && v[l.pos] == 60 { oc = 8; }   // LT
        if one && v[l.pos] == 62 { oc = 9; }   // GT
        opl := ln[l.pos];
        r := ast_sum(k, v, ln, fpc, a, l.pos + 1, l.nn);
        a.nk[r.nn] = 2; a.nl[r.nn] = l.root; a.nr[r.nn] = r.root; a.nv[r.nn] = oc;
        a.nline[r.nn] = opl;
        return NP{ pos: r.pos, nn: r.nn + 1, root: r.nn };
    }
    l
}

// THE CHECK PASS — the first consumer of the tree that is not the
// emitter, and the reason the tree exists: it looks at a whole
// expression while NO code for it has been generated yet, and emits
// nothing itself. One rule so far: every load must name a BOUND
// variable — one of the enclosing function's parameters, or a name a
// `:=` statement already bound in this scope (bv holds their symbol
// indexes, bc many of them are live). Anything else is refused with
// the node's recorded source line. More rules land on this same walk
// as the toy grows (types, arity was the parser's, folding is next
// door) — which is exactly how ncc's check_expr accreted.
fn check_node(a: Ast, bv: *i64, bc: i64, idx: i64) {
    if a.nk[idx] == 1 {                    // load: the symbol must be bound
        mut ok := false;
        mut i := 0;
        while i < bc {
            if bv[i] == a.nv[idx] { ok = true; }
            i += 1;
        }
        if !ok {
            fail(a.nline[idx], "unknown variable");
        }
    }
    if a.nk[idx] == 2 {                    // binop: both children
        check_node(a, bv, bc, a.nl[idx]);
        check_node(a, bv, bc, a.nr[idx]);
    }
    if a.nk[idx] == 3 {                    // unary minus: its operand
        check_node(a, bv, bc, a.nl[idx]);
    }
    if a.nk[idx] == 4 {                    // call: every argument tree
        mut q := 0;
        while q < a.nl[idx] {
            check_node(a, bv, bc, a.na[idx * 4 + q]);
            q += 1;
        }
    }
}

// Phase two: the postorder walk. Children first, the node's own
// operation last — and the walker emits byte-for-byte what the fused
// parser-emitter used to, no matter how the tree was built. The
// caller-save discipline lives HERE now: parse decided WHAT (a call of
// f with these argument trees), this decides HOW — save the callee's
// slots in order, evaluate all the argument trees, bind in reverse
// (pops hand back the last argument first), CALL, then restore each
// saved slot in reverse with SWAP + STORE beneath the returned value.
fn emit_node(a: Ast, fe: *i64, fp: *i64, code: *i64, cp: i64, idx: i64) -> i64 {
    if a.nk[idx] == 0 {                    // number: PUSH its value
        return emit2(code, cp, 1, a.nv[idx]);
    }
    if a.nk[idx] == 1 {                    // name read: LOAD its slot
        return emit2(code, cp, 11, a.nv[idx]);
    }
    if a.nk[idx] == 2 {                    // binop: lhs, rhs, then the opcode
        c := emit_node(a, fe, fp, code, cp, a.nl[idx]);
        c2 := emit_node(a, fe, fp, code, c, a.nr[idx]);
        return emit1(code, c2, a.nv[idx]);
    }
    if a.nk[idx] == 3 {                    // unary minus: operand, then NEG
        c := emit_node(a, fe, fp, code, cp, a.nl[idx]);
        return emit1(code, c, 7);
    }
    f := a.nv[idx];                        // call
    cnt := a.nl[idx];
    mut c := cp;
    mut j := 0;
    while j < cnt {                        // save the callee's slots, in order
        c = emit2(code, c, 11, fp[f * 4 + j]);
        j += 1;
    }
    mut q := 0;
    while q < cnt {                        // all argument trees, before any binds
        c = emit_node(a, fe, fp, code, c, a.na[idx * 4 + q]);
        q += 1;
    }
    mut w := cnt - 1;
    while w > -1 {                         // bind in reverse: pops give the
        c = emit2(code, c, 12, fp[f * 4 + w]);   // last argument first
        w -= 1;
    }
    c = emit2(code, c, 15, fe[f]);         // CALL the entry
    mut u := cnt - 1;
    while u > -1 {                         // restore in reverse, beneath the
        c = emit1(code, c, 17);            // returned value: SWAP + STORE
        c = emit2(code, c, 12, fp[f * 4 + u]);
        u -= 1;
    }
    c
}

// The seam between the tiers, now three beats long: parse ONE
// expression into a fresh tree (the node cursor restarts at zero —
// expression trees are transient), CHECK it against the bound set,
// then walk it. Upward this plays exactly the role the emitting
// parse_cmp played — cursors in, cursors out (bc passes through
// untouched: expressions bind nothing).
fn gen_cmp(k: *i64, v: *i64, ln: *i64, fe: *i64, fp: *i64, fpc: *i64, a: Ast, bv: *i64, bc: i64, pos: i64, code: *i64, cp: i64) -> EP {
    r := ast_cmp(k, v, ln, fpc, a, pos, 0);
    check_node(a, bv, bc, r.root);
    EP{ pos: r.pos, cp: emit_node(a, fe, fp, code, cp, r.root), bc: bc }
}

// A statement begins with `if`, `while`, or a name followed by ':='.
fn is_stmt_start(k: *i64, pos: i64) -> bool {
    k[pos] == 5 || k[pos] == 6 || (k[pos] == 1 && k[pos + 1] == 4)
}

// stmt := name ':=' cmp ';' | 'if' cmp block | 'while' cmp block
//   Control flow is where the emitter earns its keep — the jump target
//   is not known until the body has been compiled, so the JZ is emitted
//   with a placeholder and PATCHED afterwards (one index store into the
//   code buffer). `while` also emits the back-JMP to its condition, and
//   the JZ patch lands past that jump.
fn parse_stmt(k: *i64, v: *i64, ln: *i64, fe: *i64, fp: *i64, fpc: *i64, a: Ast, bv: *i64, bc: i64, pos: i64, code: *i64, cp: i64) -> EP {
    if k[pos] == 5 {                       // if cmp block [else block]
        c := gen_cmp(k, v, ln, fe, fp, fpc, a, bv, bc, pos + 1, code, cp);
        hole := c.cp + 1;                  // the JZ's target word
        r := parse_block(k, v, ln, fe, fp, fpc, a, bv, bc, c.pos, code, emit2(code, c.cp, 13, 0));
        if k[r.pos] == 8 {                 // else: the classic diamond —
            hole2 := r.cp + 1;             // the then-arm hops past the else,
            c2 := emit2(code, r.cp, 14, 0);
            code[hole] = c2;               // false lands at the else entry,
            e := parse_block(k, v, ln, fe, fp, fpc, a, bv, bc, r.pos + 1, code, c2);
            code[hole2] = e.cp;            // and the hop lands past it all
            return e;
        }
        code[hole] = r.cp;                 // no else: skip the body when false
        return r;
    }
    if k[pos] == 6 {                       // while cmp { stmts }
        top := cp;
        c := gen_cmp(k, v, ln, fe, fp, fpc, a, bv, bc, pos + 1, code, cp);
        hole := c.cp + 1;
        r := parse_block(k, v, ln, fe, fp, fpc, a, bv, bc, c.pos, code, emit2(code, c.cp, 13, 0));
        e := emit2(code, r.cp, 14, top);   // back to the condition
        code[hole] = e;                    // exit lands past the back-jump
        return EP{ pos: r.pos, cp: e, bc: bc };
    }
    slot := v[pos];                        // name ':=' cmp ';'
    r := gen_cmp(k, v, ln, fe, fp, fpc, a, bv, bc, pos + 2, code, cp);
    if !(k[r.pos] == 2 && v[r.pos] == 59) {
        fail(ln[r.pos], "expected ';' after the binding");
    }
    bv[bc] = slot;                         // bound AFTER its rhs was checked,
    EP{ pos: r.pos + 1, cp: emit2(code, r.cp, 12, slot), bc: bc + 1 }
}                                          // so `x := x + 1` cannot self-feed

// block := '{' { stmt } '}'   — statement-only; a block has no tail.
//   The bound count is SNAPSHOT at the '{' and handed back unchanged
//   at the '}': names bound inside the block die with it, because the
//   checker cannot promise the branch will have run.
fn parse_block(k: *i64, v: *i64, ln: *i64, fe: *i64, fp: *i64, fpc: *i64, a: Ast, bv: *i64, bc: i64, pos: i64, code: *i64, cp: i64) -> EP {
    if !(k[pos] == 2 && v[pos] == 123) {
        fail(ln[pos], "expected '\{'");
    }
    mut p := pos + 1;                      // skip '{'
    mut c := cp;
    mut b := bc;
    mut more := true;
    while more {
        more = false;
        if is_stmt_start(k, p) {
            r := parse_stmt(k, v, ln, fe, fp, fpc, a, bv, b, p, code, c);
            p = r.pos;
            c = r.cp;
            b = r.bc;
            more = true;
        }
    }
    if !(k[p] == 2 && v[p] == 125) {
        fail(ln[p], "expected '\}' or a statement");
    }
    EP{ pos: p + 1, cp: c, bc: bc }        // skip '}'; the block's names die
}

// fndef := 'fn' name '(' name { ',' name } ')' '{' { stmt } cmp '}'
//   The entry address is recorded BEFORE the body compiles, so a
//   function may call itself; up to four comma-separated parameters
//   record their slots in fp[f*4 + j] with the count in fpc[f]; the
//   body ends in RET, which returns its tail value.
//   A body's scope starts FRESH: its parameters are the first bound
//   names (bv is seeded from index 0 — all fndefs precede the main
//   statements, so nothing is trampled), and everything else it reads
//   must be bound by its own statements. The flat runtime table would
//   let a body read main's names, but that is caller-save's private
//   business — the checker enforces the lexical story.
fn parse_fndef(k: *i64, v: *i64, ln: *i64, fe: *i64, fp: *i64, fpc: *i64, a: Ast, bv: *i64, bc: i64, pos: i64, code: *i64, cp: i64) -> EP {
    f := v[pos + 1];
    fe[f] = cp;
    mut p := pos + 3;                      // fn +0, name +1, '(' +2, params...
    mut j := 0;
    mut going := true;
    while going {
        going = false;
        if k[p] == 1 {
            fp[f * 4 + j] = v[p];
            bv[j] = v[p];                  // a parameter is born bound
            j += 1;
            p += 1;
            if k[p] == 2 && v[p] == 44 {   // ',' — another parameter follows
                p += 1;
                going = true;
            }
        }
    }
    fpc[f] = j;
    p += 2;                                // skip ')' '{'
    mut c := cp;
    mut b := j;                            // the body's scope: params only
    mut more := true;
    while more {
        more = false;
        if is_stmt_start(k, p) {
            r := parse_stmt(k, v, ln, fe, fp, fpc, a, bv, b, p, code, c);
            p = r.pos;
            c = r.cp;
            b = r.bc;
            more = true;
        }
    }
    t := gen_cmp(k, v, ln, fe, fp, fpc, a, bv, b, p, code, c);  // body tail = return value
    EP{ pos: t.pos + 1, cp: emit1(code, t.cp, 16), bc: bc }   // skip '}', RET
}

// program := { fndef } { stmt } cmp
//   If any functions exist, a JMP with a placeholder target is emitted
//   first and patched to hop over their bodies — execution starts at
//   the main statements, functions are entered only by CALL.
fn parse_program(k: *i64, v: *i64, ln: *i64, fe: *i64, fp: *i64, fpc: *i64, a: Ast, bv: *i64, pos: i64, code: *i64, cp: i64) -> EP {
    mut p := pos;
    mut c := cp;
    if k[p] == 7 {
        c = emit2(code, c, 14, 0);
        hole := c - 1;                     // the hop-over JMP's target
        mut fns := true;
        while fns {
            fns = false;
            if k[p] == 7 {
                r := parse_fndef(k, v, ln, fe, fp, fpc, a, bv, 0, p, code, c);
                p = r.pos;
                c = r.cp;
                fns = true;
            }
        }
        code[hole] = c;                    // main statements start here
    }
    mut b := 0;                            // the top scope starts empty
    mut more := true;
    while more {
        more = false;
        if is_stmt_start(k, p) {
            r := parse_stmt(k, v, ln, fe, fp, fpc, a, bv, b, p, code, c);
            p = r.pos;
            c = r.cp;
            b = r.bc;
            more = true;
        }
    }
    t := gen_cmp(k, v, ln, fe, fp, fpc, a, bv, b, p, code, c);
    if k[t.pos] != 9 {
        fail(ln[t.pos], "unexpected input after the tail expression");
    }
    t
}

// The stack machine: arithmetic, comparisons, a variable table, jumps,
// and calls. CALL pushes the return address and jumps; RET consumes it
// beneath the return value; SWAP serves the caller-save restore.
fn run(prog: *i64, stk: *i64, vars: *i64) -> i64 {
    mut pc := 0;
    mut sp := 0;
    mut running := true;
    while running {
        op := prog[pc];
        if op == 0 { running = false; }
        if op == 1 { stk[sp] = prog[pc + 1]; sp += 1; pc += 2; }
        if op == 2 { stk[sp - 2] = stk[sp - 2] + stk[sp - 1]; sp -= 1; pc += 1; }
        if op == 3 { stk[sp - 2] = stk[sp - 2] - stk[sp - 1]; sp -= 1; pc += 1; }
        if op == 4 { stk[sp - 2] = stk[sp - 2] * stk[sp - 1]; sp -= 1; pc += 1; }
        if op == 5 { stk[sp - 2] = stk[sp - 2] / stk[sp - 1]; sp -= 1; pc += 1; }
        if op == 6 { stk[sp - 2] = stk[sp - 2] % stk[sp - 1]; sp -= 1; pc += 1; }
        if op == 7 { stk[sp - 1] = -stk[sp - 1]; pc += 1; }
        if op == 8 {
            mut t := 0;
            if stk[sp - 2] < stk[sp - 1] { t = 1; }
            stk[sp - 2] = t; sp -= 1; pc += 1;
        }
        if op == 9 {
            mut t := 0;
            if stk[sp - 2] > stk[sp - 1] { t = 1; }
            stk[sp - 2] = t; sp -= 1; pc += 1;
        }
        if op == 10 {
            mut t := 0;
            if stk[sp - 2] == stk[sp - 1] { t = 1; }
            stk[sp - 2] = t; sp -= 1; pc += 1;
        }
        if op == 11 { stk[sp] = vars[prog[pc + 1]]; sp += 1; pc += 2; }
        if op == 12 { sp -= 1; vars[prog[pc + 1]] = stk[sp]; pc += 2; }
        if op == 13 {
            sp -= 1;
            if stk[sp] == 0 { pc = prog[pc + 1]; } else { pc += 2; }
        }
        if op == 14 { pc = prog[pc + 1]; }
        if op == 15 { stk[sp] = pc + 2; sp += 1; pc = prog[pc + 1]; }
        if op == 16 {
            rv := stk[sp - 1];             // the body's tail value
            pc = stk[sp - 2];              // the pushed return address
            stk[sp - 2] = rv;
            sp -= 1;
        }
        if op == 17 {
            t := stk[sp - 1];
            stk[sp - 1] = stk[sp - 2];
            stk[sp - 2] = t;
            pc += 1;
        }
    }
    stk[0]
}

// The whole pipeline in one call: tokens in, code out, value from the VM.
fn show(src: str, k: *i64, v: *i64, ln: *i64, code: *i64, stk: *i64, vars: *i64,
        fe: *i64, fp: *i64, fpc: *i64, a: Ast, bv: *i64, nb: *u8, ss: *i64, sl: *i64) {
    lex(src, k, v, ln, nb, ss, sl);
    r := parse_program(k, v, ln, fe, fp, fpc, a, bv, 0, code, 0);
    words := emit1(code, r.cp, 0);         // HALT closes the program
    val := run(code, stk, vars);
    put("{src}\n  ->  {val}   [{words} code words]\n");
}

fn main() -> i64 {
    k := alloc_words(96);
    v := alloc_words(96);
    code := alloc_words(256);
    stk := alloc_words(64);
    vars := alloc_words(64);               // slots are symbol indexes
    fe := alloc_words(64);
    fp := alloc_words(256);                // 64 fns x up to 4 param slots
    fpc := alloc_words(64);
    nb := alloc_bytes(256);                // the interned-names buffer
    ss := alloc_words(64);
    sl := alloc_words(64);
    ln := alloc_words(96);                 // per-token source lines (rung 2)
    ast := Ast{ nk: alloc_words(64), nl: alloc_words(64), nr: alloc_words(64),
                nv: alloc_words(64), na: alloc_words(256),
                nline: alloc_words(64) };  // rung 3 + the check pass
    bv := alloc_words(64);                 // the bound-name list
    put("a checker over the AST - lex -> parse -> check -> emit -> run:\n");
    // Braces are escaped so they read as text, not interpolation (§2.5).
    show("fn max(a, b) \{ m := 0; if a > b \{ m := a; \} else \{ m := b; \} m \} max(3, 9) + max(7, 2)",
         k, v, ln, code, stk, vars, fe, fp, fpc, ast, bv, nb, ss, sl);
    show("fn gcd(a, b) \{ r := a; if b > 0 \{ r := gcd(b, a % b); \} r \} gcd(48, 18)",
         k, v, ln, code, stk, vars, fe, fp, fpc, ast, bv, nb, ss, sl);
    show("fn fact(n) \{ r := 1; if n > 1 \{ r := n * fact(n - 1); \} r \} fact(5)",
         k, v, ln, code, stk, vars, fe, fp, fpc, ast, bv, nb, ss, sl);
    // The broken program runs LAST (fail() ends the process — one failing
    // demo per run). It PARSES cleanly; what is wrong with it is semantic:
    // b is bound only inside the if arm, so the tail's read of b is
    // refused by the CHECK pass — a bug no parser could see. (The parse
    // diagnostics from rung 2 still guard their expect points; their demo
    // rotated out for the checker's, both end through the same fail().)
    put("and a deliberately broken program:\n");
    show("a := 1;\nif a > 0 \{ b := a; \} b",
         k, v, ln, code, stk, vars, fe, fp, fpc, ast, bv, nb, ss, sl);
    0
}
