// check.n — ncc's checker, rewritten in N. The third module of the
// self-host ladder (lex -> parse -> check -> gen; see
// ../docs/selfhost.md, "check.n's anchor").
//
// THE CHAIN ACCRETES, AND THE TREE MATERIALIZES: this file carries
// parse.n's code forward, but transformed — the parser no longer
// prints a postorder dump as it goes; every parse function RETURNS A
// NODE INDEX into a parallel-array AST. Checking needs the program
// as data, so the print-as-you-parse trick retires exactly here (the
// toy's history said it would). The five category passes collapse
// back to ONE pass: check.n's output is errors, not ordered dumps,
// so there is no dump order to buy — declarations land in tables the
// way ncc's own single pass builds them.
//
// THE CONTRACT IS DIFFERENTIAL, against the NEGATIVE CORPUS
// (tests/bad/ + MANIFEST.txt): for every claimed file, check.n must
// print ncc's exact first error — location AND wording — then stop
// (ncc dies on its first error; the flag st[41] mirrors that). One
// normalization, documented in tests/bad/README.md: check.n reads a
// fixed target path and cannot know the original basename, so it
// prints `line: message` and the harness strips the filename column
// from the manifest side (cut -d: -f2-). A clean program prints
// NOTHING — the harness also claims positive targets whose output
// must be empty.
//
// Claimed manifest rows (rungs 1+2 — the name-resolution family plus
// the structural family, no type inference needed):
//   bad_undecl.n        undeclared variable 'y'
//   bad_mut.n           cannot assign to immutable 'x' (...)
//   bad_unknown_fn.n    unknown function 'launch'
//   bad_arity.n         'write' takes 3 argument(s), got 1
//   bad_for_mut.n       cannot assign to immutable 'i' (...)
//   bad_struct_mut.n    cannot assign to immutable 'r' (...)
//   bad_caps.n          'write' requires the syscall capability (...)
//   bad_cname.n         function name 'double' is a C keyword (...)
//   bad_defer_nested.n  defer is only allowed in the (...) outermost block
// and two positive silences: hello.n, countdown.n. Rung 2's checks:
// the capability gate (XFNS-only, ncc's xfn_caps — fn-to-fn calls
// never gate; checked between existence and arity), the C-keyword
// name refusal (parse-time, at the function's name — ncc's pexp
// timing), and the defer depth judgment (first thing in the defer
// case, before its expression resolves — ncc's S_DEFER order;
// BLOCK_DEPTH rides st[43], 1 = the function's own block).
//
// Parse coverage, stated honestly: extern blocks and functions are
// parsed for real (name/arity tables + full body trees); struct,
// enum and impl items are brace-SKIPPED (their rows arrive with the
// decl-table rung); `match` is not parsed yet (its binds need scope
// seeding — a later rung). The checker resolves paths against a
// scoped name table (params seeded immutable, blocks save/restore,
// innermost shadows — ncc's VARS discipline), enforces `mut` on
// assignment roots (field writes mutate the root binding), and holds
// calls to the merged extern+fn table (ncc's fn_lookup order) for
// existence and arity. Everything else recurses generically; types,
// caps, methods, enums and pageflags consts are later rungs.
//
// THE TREE: one arena, 8 words per node —
//   [0] kind  [1] a  [2] b  [3] c  [4] line  [5] span-start
//   [6] span-len  [7] next (statement chaining)
// kinds: expressions 1 int(a=val) 2 bool 3 str(a=count)
//   4 interp(a=list,b=holes) 5 path(span) 6 call(a=callee,b=list,
//   c=nargs) 7 field(a=base,span) 8 un(a,c=op) 9 bin(a,b,c=op)
//   10 cast(a) 11 slit(a=list,c=n,span) 12 elit(a=list,c=n,span)
//   13 index(a,b); statements 20 let(a=rhs,c=mut,span) 21 assign
//   (a=lhs,b=rhs,c=aop) 22 ret(a) 23 expr(a,c=try) 24 while(a,b)
//   25 if(a,b,c=else) 26 break 27 continue 28 defer(a) 30 for
//   (a=lo,b=hi,c=body,span); 40 block(a=first,b=tail,c=count).
// Node 0 is nil. Child lists (call args, interp holes, literal
// values, fn params as span pairs) live in a flat list arena.
//
// State lives in one sbrk'd word block:
//   st[0..32]  the lexer + token window (parse.n's block, unchanged)
//   st[33] node arena   st[34] node count   st[35] list arena
//   st[36] list count   st[37] fn table (externs + fns, 8 words:
//     span, np, caps, body, param-list start, kind 0=extern 1=fn)
//   st[38] fn count     st[39] vars (span + mut, 3 words)
//   st[40] var count    st[41] the error flag (first error wins)
//
// The target path is fixed: /tmp/n_check_target.n — the harness
// copies each source there before a run.

#[caps(syscall)]
extern syscall {
    fn write(fd: i32, buf: #[user] *u8, len: isize) -> i64 = 1
    fn sys_open(path: *u8, flags: i64, mode: i64) -> i64   = 3
    fn sys_read(fd: i64, buf: *u8, len: isize) -> i64      = 4
    fn sys_close(fd: i64) -> i64                           = 5
    fn sys_sbrk(incr: i64) -> i64                          = 7
}

#[caps(syscall)]
fn put(s: str) {
    write(1, s.ptr as #[user] *u8, s.len as isize);
}

// Write buf[s .. s+l) — the span echo, from lex.n's dump.
#[caps(syscall)]
fn put_span(p: *u8, s: i64, l: i64) {
    write(1, (p as addr + s as addr) as #[user] *u8, l as isize);
}

fn is_idc(b: i64) -> bool {
    return (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95;
}

fn is_dg(b: i64) -> bool {
    return b >= 48 && b <= 57;
}

fn is_hx(b: i64) -> bool {
    return is_dg(b) || (b >= 97 && b <= 102) || (b >= 65 && b <= 70);
}

fn hxv(d: i64) -> i64 {
    if is_dg(d) { return d - 48; }
    if d >= 97 { return d - 87; }          // a-f
    return d - 55;                         // A-F
}

fn eq2(p: *u8, s: i64, a: i64, b: i64) -> bool {
    return p[s] as i64 == a && p[s + 1] as i64 == b;
}

fn eq3(p: *u8, s: i64, a: i64, b: i64, c: i64) -> bool {
    return eq2(p, s, a, b) && p[s + 2] as i64 == c;
}

fn eq4(p: *u8, s: i64, a: i64, b: i64, c: i64, d: i64) -> bool {
    return eq3(p, s, a, b, c) && p[s + 3] as i64 == d;
}

fn eq5(p: *u8, s: i64, a: i64, b: i64, c: i64, d: i64, e: i64) -> bool {
    return eq4(p, s, a, b, c, d) && p[s + 4] as i64 == e;
}

fn eq6(p: *u8, s: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> bool {
    return eq5(p, s, a, b, c, d, e) && p[s + 5] as i64 == f;
}

fn eq7(p: *u8, s: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64) -> bool {
    return eq6(p, s, a, b, c, d, e, f) && p[s + 6] as i64 == g;
}

fn eq8(p: *u8, s: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> bool {
    return eq7(p, s, a, b, c, d, e, f, g) && p[s + 7] as i64 == h;
}

// ncc's keyword table (the lex.n copy, unchanged).
fn kwlook(p: *u8, s: i64, n: i64) -> i64 {
    if n == 2 {
        if eq2(p, s, 102, 110) { return 10; }             // fn
        if eq2(p, s, 97, 115) { return 18; }              // as
        if eq2(p, s, 105, 102) { return 13; }             // if
        if eq2(p, s, 105, 110) { return 29; }             // in
    }
    if n == 3 {
        if eq3(p, s, 109, 117, 116) { return 11; }        // mut
        if eq3(p, s, 114, 97, 119) { return 19; }         // raw
        if eq3(p, s, 102, 111, 114) { return 28; }        // for
        if eq3(p, s, 111, 119, 110) { return 36; }        // own
    }
    if n == 4 {
        if eq4(p, s, 101, 108, 115, 101) { return 14; }   // else
        if eq4(p, s, 116, 114, 117, 101) { return 20; }   // true
        if eq4(p, s, 101, 110, 117, 109) { return 24; }   // enum
        if eq4(p, s, 105, 109, 112, 108) { return 27; }   // impl
    }
    if n == 5 {
        if eq5(p, s, 119, 104, 105, 108, 101) { return 15; }   // while
        if eq5(p, s, 98, 114, 101, 97, 107) { return 16; }     // break
        if eq5(p, s, 102, 97, 108, 115, 101) { return 21; }    // false
        if eq5(p, s, 100, 101, 102, 101, 114) { return 23; }   // defer
        if eq5(p, s, 109, 97, 116, 99, 104) { return 25; }     // match
    }
    if n == 6 {
        if eq6(p, s, 101, 120, 116, 101, 114, 110) { return 8; }    // extern
        if eq6(p, s, 115, 116, 114, 117, 99, 116) { return 22; }    // struct
        if eq6(p, s, 114, 101, 116, 117, 114, 110) { return 12; }   // return
    }
    if n == 7 {
        if eq7(p, s, 115, 121, 115, 99, 97, 108, 108) { return 9; } // syscall
    }
    if n == 8 {
        if eq8(p, s, 99, 111, 110, 116, 105, 110, 117, 101) { return 17; }  // continue
    }
    return 7;                              // T_IDENT
}

// The lex.n scanner pair, unchanged: scan_string + next_kind.
fn scan_string(p: *u8, n: i64, st: *i64, cont: i64) -> i64 {
    st[5] = st[1];
    mut cnt := 0;                          // processed-body byte count
    mut going := true;
    while going {
        if st[0] >= n { return -1; }       // unterminated string
        b := p[st[0]] as i64;
        if b == 34 {                       // the closing quote
            st[0] = st[0] + 1;
            st[6] = cnt;
            if cont == 1 { return 5; }
            return 2;
        }
        if b == 123 {                      // a hole opens: push and hand
            st[0] = st[0] + 1;             // the stream to the expression
            if st[2] + 1 >= 16 { return -1; }   // interpolation too deep
            st[2] = st[2] + 1;
            st[8 + st[2]] = st[3];
            st[6] = cnt;
            if cont == 1 { return 4; }
            return 3;
        }
        if b == 92 {                       // an escape: validate + skip,
            st[0] = st[0] + 1;             // one processed byte
            if st[0] >= n { return -1; }
            e := p[st[0]] as i64;
            st[0] = st[0] + 1;
            ok := e == 110 || e == 116 || e == 114 || e == 48 || e == 92
               || e == 34 || e == 39 || e == 123 || e == 125;
            if !ok { return -1; }          // bad escape
            cnt = cnt + 1;
            continue;
        }
        if b == 10 { st[1] = st[1] + 1; }
        cnt = cnt + 1;
        st[0] = st[0] + 1;
    }
    0
}

fn next_kind(p: *u8, n: i64, st: *i64) -> i64 {
    if st[4] == 1 {                        // '}' closed a hole: resume
        st[4] = 0;
        return scan_string(p, n, st, 1);
    }
    mut b := 0;
    mut scanning := true;
    while scanning {                       // whitespace + comments
        if st[0] >= n { st[5] = st[1]; return 0; }   // T_EOF
        b = p[st[0]] as i64;
        if b == 32 || b == 9 || b == 13 { st[0] = st[0] + 1; continue; }
        if b == 10 { st[0] = st[0] + 1; st[1] = st[1] + 1; continue; }
        if b == 47 && st[0] + 1 < n && p[st[0] + 1] as i64 == 47 {
            while st[0] < n && p[st[0]] as i64 != 10 { st[0] = st[0] + 1; }
            continue;
        }
        if b == 47 && st[0] + 1 < n && p[st[0] + 1] as i64 == 42 {
            mut d := 1;
            st[0] = st[0] + 2;
            while st[0] < n && d > 0 {
                c := p[st[0]] as i64;
                if c == 47 && st[0] + 1 < n && p[st[0] + 1] as i64 == 42 {
                    d = d + 1;
                    st[0] = st[0] + 2;
                    continue;
                }
                if c == 42 && st[0] + 1 < n && p[st[0] + 1] as i64 == 47 {
                    d = d - 1;
                    st[0] = st[0] + 2;
                    continue;
                }
                if c == 10 { st[1] = st[1] + 1; }
                st[0] = st[0] + 1;
            }
            continue;
        }
        scanning = false;
    }
    st[5] = st[1];
    if is_idc(b) {
        s := st[0];
        while st[0] < n && (is_idc(p[st[0]] as i64) || is_dg(p[st[0]] as i64)) {
            st[0] = st[0] + 1;
        }
        st[6] = s;
        st[7] = st[0] - s;
        return kwlook(p, s, st[0] - s);
    }
    if is_dg(b) {
        mut v := 0;
        if b == 48 && st[0] + 1 < n && p[st[0] + 1] as i64 == 120 {
            st[0] = st[0] + 2;
            while st[0] < n && (is_hx(p[st[0]] as i64) || p[st[0]] as i64 == 95) {
                d := p[st[0]] as i64;
                if d != 95 { v = v * 16 + hxv(d); }
                st[0] = st[0] + 1;
            }
            st[6] = v;
            return 1;
        }
        while st[0] < n && (is_dg(p[st[0]] as i64) || p[st[0]] as i64 == 95) {
            d := p[st[0]] as i64;
            if d != 95 { v = v * 10 + (d - 48); }
            st[0] = st[0] + 1;
        }
        st[6] = v;
        return 1;                          // T_INT
    }
    if b == 34 {
        st[0] = st[0] + 1;
        return scan_string(p, n, st, 0);
    }
    st[0] = st[0] + 1;
    mut b2 := 0;
    if st[0] < n { b2 = p[st[0]] as i64; }
    if b == 40 { return 37; }              // (
    if b == 41 { return 38; }              // )
    if b == 44 { return 41; }              // ,
    if b == 59 { return 42; }              // ;
    if b == 46 {
        if b2 == 46 { st[0] = st[0] + 1; return 30; }
        return 68;
    }
    if b == 91 { return 34; }              // [
    if b == 93 { return 35; }              // ]
    if b == 63 { return 69; }              // ?
    if b == 94 { return 65; }              // ^
    if b == 37 { return 51; }              // %
    if b == 42 { return 49; }              // *
    if b == 47 { return 50; }              // /
    if b == 123 {
        st[3] = st[3] + 1;
        return 39;
    }
    if b == 125 {
        if st[2] >= 0 && st[3] == st[8 + st[2]] {
            st[2] = st[2] - 1;
            st[4] = 1;
            return 6;
        }
        st[3] = st[3] - 1;
        return 40;
    }
    if b == 58 {
        if b2 == 61 { st[0] = st[0] + 1; return 44; }
        return 43;
    }
    if b == 45 {
        if b2 == 62 { st[0] = st[0] + 1; return 45; }
        if b2 == 61 { st[0] = st[0] + 1; return 53; }
        return 48;
    }
    if b == 43 {
        if b2 == 61 { st[0] = st[0] + 1; return 52; }
        return 47;
    }
    if b == 61 {
        if b2 == 61 { st[0] = st[0] + 1; return 54; }
        if b2 == 62 { st[0] = st[0] + 1; return 26; }
        return 46;
    }
    if b == 33 {
        if b2 == 61 { st[0] = st[0] + 1; return 55; }
        return 60;
    }
    if b == 60 {
        if b2 == 61 { st[0] = st[0] + 1; return 57; }
        if b2 == 60 { st[0] = st[0] + 1; return 66; }
        return 56;
    }
    if b == 62 {
        if b2 == 61 { st[0] = st[0] + 1; return 59; }
        if b2 == 62 { st[0] = st[0] + 1; return 67; }
        return 58;
    }
    if b == 38 {
        if b2 == 38 { st[0] = st[0] + 1; return 61; }
        return 63;
    }
    if b == 124 {
        if b2 == 124 { st[0] = st[0] + 1; return 62; }
        return 64;
    }
    if b == 35 {
        if st[0] + 6 <= n && eq6(p, st[0], 91, 117, 115, 101, 114, 93) {
            st[0] = st[0] + 6;
            return 31;                     // #[user]
        }
        if st[0] + 15 <= n && eq8(p, st[0], 91, 99, 97, 112, 115, 40, 115, 121)
            && eq7(p, st[0] + 8, 115, 99, 97, 108, 108, 41, 93) {
            st[0] = st[0] + 15;
            return 32;                     // #[caps(syscall)]
        }
        if st[0] + 6 <= n && eq6(p, st[0], 91, 100, 114, 111, 112, 40) {
            st[0] = st[0] + 6;
            s2 := st[0];
            mut got := false;
            while st[0] < n && (is_idc(p[st[0]] as i64) || is_dg(p[st[0]] as i64)) {
                st[0] = st[0] + 1;
                got = true;
            }
            if !got { return -1; }
            if st[0] + 2 > n { return -1; }
            if !(p[st[0]] as i64 == 41 && p[st[0] + 1] as i64 == 93) { return -1; }
            st[6] = s2;
            st[7] = st[0] - s2;
            st[0] = st[0] + 2;
            return 33;
        }
        return -1;                         // unknown attribute
    }
    return -1;                             // unexpected character
}

// ---------------------------------------------------------------- //
// The token window (parse.n's, unchanged): CUR at st[24..27], NEXT
// at st[28..31]; adv() shifts and lexes.

fn adv(p: *u8, n: i64, st: *i64) {
    st[24] = st[28]; st[25] = st[29]; st[26] = st[30]; st[27] = st[31];
    k := next_kind(p, n, st);
    st[28] = k; st[29] = st[5]; st[30] = st[6]; st[31] = st[7];
}

fn ck(st: *i64, k: i64) -> bool {
    return st[24] == k;
}

fn ck2(st: *i64, k: i64) -> bool {
    return st[28] == k;
}

fn acc(p: *u8, n: i64, st: *i64, k: i64) -> bool {
    if st[24] == k { adv(p, n, st); return true; }
    return false;
}

// An unsupported or unexpected construct. Claimed targets are valid
// sources inside the stated coverage, so this line appearing in a
// run means the PARSER is wrong — the differential catches it.
fn perr(st: *i64) {
    l := st[25];
    put("PARSE-ERR {l}\n");
}

// ---------------------------------------------------------------- //
// The tree and the tables.

// Allocate one node; returns its index. The next-link slot starts 0.
fn nnew(st: *i64, k: i64, a: i64, b: i64, c: i64, ln: i64, ss: i64, sl: i64) -> i64 {
    nd := st[33] as *i64;
    i := st[34];
    st[34] = i + 1;
    nd[i * 8] = k;
    nd[i * 8 + 1] = a;
    nd[i * 8 + 2] = b;
    nd[i * 8 + 3] = c;
    nd[i * 8 + 4] = ln;
    nd[i * 8 + 5] = ss;
    nd[i * 8 + 6] = sl;
    nd[i * 8 + 7] = 0;
    return i;
}

// Append one word to the flat list arena; returns its index.
fn ladd(st: *i64, v: i64) -> i64 {
    al := st[35] as *i64;
    i := st[36];
    al[i] = v;
    st[36] = i + 1;
    return i;
}

// Byte-compare two source spans (names are equal iff same bytes).
fn span_eq(p: *u8, s1: i64, l1: i64, s2: i64, l2: i64) -> bool {
    if l1 != l2 { return false; }
    mut i := 0;
    while i < l1 {
        if p[s1 + i] as i64 != p[s2 + i] as i64 { return false; }
        i = i + 1;
    }
    return true;
}

// ncc's C_KEYWORDS table: N identifiers lower into the generated C
// verbatim, so a name that is a C keyword would break the C build
// downstream — ncc rejects it at the declaration site instead, and
// check.n mirrors the judgment (kwlook's length-gated shape; N's own
// keywords never reach an identifier slot on either side).
fn is_ckw(p: *u8, s: i64, n: i64) -> bool {
    if n == 2 {
        if eq2(p, s, 100, 111) { return true; }                 // do
    }
    if n == 3 {
        if eq3(p, s, 105, 110, 116) { return true; }            // int
    }
    if n == 4 {
        if eq4(p, s, 97, 117, 116, 111) { return true; }        // auto
        if eq4(p, s, 99, 97, 115, 101) { return true; }         // case
        if eq4(p, s, 99, 104, 97, 114) { return true; }         // char
        if eq4(p, s, 103, 111, 116, 111) { return true; }       // goto
        if eq4(p, s, 108, 111, 110, 103) { return true; }       // long
        if eq4(p, s, 118, 111, 105, 100) { return true; }       // void
    }
    if n == 5 {
        if eq5(p, s, 99, 111, 110, 115, 116) { return true; }   // const
        if eq5(p, s, 102, 108, 111, 97, 116) { return true; }   // float
        if eq5(p, s, 115, 104, 111, 114, 116) { return true; }  // short
        if eq5(p, s, 117, 110, 105, 111, 110) { return true; }  // union
    }
    if n == 6 {
        if eq6(p, s, 100, 111, 117, 98, 108, 101) { return true; }   // double
        if eq6(p, s, 105, 110, 108, 105, 110, 101) { return true; }  // inline
        if eq6(p, s, 115, 105, 103, 110, 101, 100) { return true; }  // signed
        if eq6(p, s, 115, 105, 122, 101, 111, 102) { return true; }  // sizeof
        if eq6(p, s, 115, 116, 97, 116, 105, 99) { return true; }    // static
        if eq6(p, s, 115, 119, 105, 116, 99, 104) { return true; }   // switch
    }
    if n == 7 {
        if eq7(p, s, 100, 101, 102, 97, 117, 108, 116) { return true; }   // default
        if eq7(p, s, 116, 121, 112, 101, 100, 101, 102) { return true; }  // typedef
    }
    if n == 8 {
        if eq8(p, s, 114, 101, 103, 105, 115, 116, 101, 114) { return true; }  // register
        if eq8(p, s, 114, 101, 115, 116, 114, 105, 99, 116) { return true; }   // restrict
        if eq8(p, s, 117, 110, 115, 105, 103, 110, 101, 100) { return true; }  // unsigned
        if eq8(p, s, 118, 111, 108, 97, 116, 105, 108, 101) { return true; }   // volatile
    }
    return false;
}

// The C-keyword refusal, ncc's wording. ncc checks EVERY declaration
// site (its pexp does it for free); check.n mirrors the function-name
// site — the one the corpus exercises — and the other sites arrive as
// rows demand them. Fires at parse time, like ncc's.
#[caps(syscall)]
fn cname_fn(p: *u8, st: *i64, ss: i64, sl: i64, ln: i64) -> bool {
    if is_ckw(p, ss, sl) {
        put("{ln}: function name '");
        put_span(p, ss, sl);
        put("' is a C keyword — generated code uses names verbatim, pick another name\n");
        st[41] = 1;
        return true;
    }
    return false;
}

// One record in the merged extern+fn table (declaration order — the
// order ncc's fn_lookup searches: XFNS first, then FNS; our targets
// declare externs first, so one table preserves it).
fn fadd(st: *i64, ss: i64, sl: i64, np: i64, caps: i64, body: i64, pst: i64, knd: i64) {
    ft := st[37] as *i64;
    i := st[38];
    ft[i * 8] = ss;
    ft[i * 8 + 1] = sl;
    ft[i * 8 + 2] = np;
    ft[i * 8 + 3] = caps;
    ft[i * 8 + 4] = body;
    ft[i * 8 + 5] = pst;
    ft[i * 8 + 6] = knd;
    ft[i * 8 + 7] = 0;
    st[38] = i + 1;
}

fn ffind(p: *u8, st: *i64, ss: i64, sl: i64) -> i64 {
    ft := st[37] as *i64;
    mut i := 0;
    while i < st[38] {
        if span_eq(p, ft[i * 8], ft[i * 8 + 1], ss, sl) { return i; }
        i = i + 1;
    }
    return -1;
}

// The struct table (ncc's STRUCTS/struct_lookup): 4-word records —
// name span, field count, field-record start (6-word span+T records
// in the flat list arena, the same shape params use).
fn sadd(st: *i64, ss: i64, sl: i64, nf: i64, fst: i64) {
    sa := st[49] as *i64;
    i := st[50];
    sa[i * 4] = ss;
    sa[i * 4 + 1] = sl;
    sa[i * 4 + 2] = nf;
    sa[i * 4 + 3] = fst;
    st[50] = i + 1;
}

fn sfind(p: *u8, st: *i64, ss: i64, sl: i64) -> i64 {
    sa := st[49] as *i64;
    mut i := 0;
    while i < st[50] {
        if span_eq(p, sa[i * 4], sa[i * 4 + 1], ss, sl) { return i; }
        i = i + 1;
    }
    return -1;
}

// Field q of struct record si, as (span, T) out of the list arena.
fn sfty(st: *i64, si: i64, q: i64) -> T {
    sa := st[49] as *i64;
    al := st[35] as *i64;
    r := sa[si * 4 + 3] + q * 6;
    T{ pt: al[r + 2], us: al[r + 3], s: al[r + 4], l: al[r + 5] }
}

// The scoped name table: ncc's VARS discipline — vars_add appends,
// vars_find scans backward (innermost shadows), blocks record the
// count on entry and truncate on exit.
fn vadd(st: *i64, ss: i64, sl: i64, m: i64, t: T) {
    va := st[39] as *i64;
    i := st[40];
    va[i * 8] = ss;
    va[i * 8 + 1] = sl;
    va[i * 8 + 2] = m;
    va[i * 8 + 3] = t.pt;
    va[i * 8 + 4] = t.us;
    va[i * 8 + 5] = t.s;
    va[i * 8 + 6] = t.l;
    va[i * 8 + 7] = 0;
    st[40] = i + 1;
}

fn vty(st: *i64, v: i64) -> T {
    va := st[39] as *i64;
    T{ pt: va[v * 8 + 3], us: va[v * 8 + 4], s: va[v * 8 + 5], l: va[v * 8 + 6] }
}

fn vfind(p: *u8, st: *i64, ss: i64, sl: i64) -> i64 {
    va := st[39] as *i64;
    mut i := st[40] - 1;
    while i >= 0 {
        if span_eq(p, va[i * 8], va[i * 8 + 1], ss, sl) { return i; }
        i = i - 1;
    }
    return -1;
}

// ---------------------------------------------------------------- //
// Types. ncc's Ty={name,ptrs,is_user} is exactly the parser's T
// (pt, us, name-span); sl == 0 marks "no type" (void), ncc's NULL
// name. SYNTHESIZED types (an int literal is "i64" with no source
// span to point at) use the INTERN TRICK: the six fixed names are
// appended after the source text in the same buffer — the lexer
// never sees them (its length excludes the tail) and span_eq stays
// uniform. st[44] = the intern base; offsets are fixed:
//   +0 i64(3)  +3 bool(4)  +7 str(3)  +10 u8(2)  +12 u64(3)
//   +15 void(4)

fn t_i64(st: *i64) -> T  { return T{ pt: 0, us: 0, s: st[44], l: 3 }; }
fn t_bool(st: *i64) -> T { return T{ pt: 0, us: 0, s: st[44] + 3, l: 4 }; }
fn t_str(st: *i64) -> T  { return T{ pt: 0, us: 0, s: st[44] + 7, l: 3 }; }
fn t_pu8(st: *i64) -> T  { return T{ pt: 1, us: 0, s: st[44] + 10, l: 2 }; }
fn t_u8(st: *i64) -> T   { return T{ pt: 0, us: 0, s: st[44] + 10, l: 2 }; }
fn t_u64(st: *i64) -> T  { return T{ pt: 0, us: 0, s: st[44] + 12, l: 3 }; }
fn t_void() -> T         { return T{ pt: 0, us: 0, s: 0, l: 0 }; }

fn span_is(p: *u8, t: T, ss: i64, sl: i64) -> bool {
    return t.pt == 0 && span_eq(p, t.s, t.l, ss, sl);
}

// ncc's ty_is_int: the twelve integer names (bool counts — C
// semantics), value types only.
fn is_int_ty(p: *u8, t: T) -> bool {
    if t.pt != 0 || t.l == 0 { return false; }
    s := t.s;
    if t.l == 2 {
        if eq2(p, s, 105, 56) { return true; }             // i8
        if eq2(p, s, 117, 56) { return true; }             // u8
    }
    if t.l == 3 {
        if eq3(p, s, 105, 49, 54) { return true; }         // i16
        if eq3(p, s, 117, 49, 54) { return true; }         // u16
        if eq3(p, s, 105, 51, 50) { return true; }         // i32
        if eq3(p, s, 117, 51, 50) { return true; }         // u32
        if eq3(p, s, 105, 54, 52) { return true; }         // i64
        if eq3(p, s, 117, 54, 52) { return true; }         // u64
    }
    if t.l == 4 {
        if eq4(p, s, 98, 111, 111, 108) { return true; }   // bool
        if eq4(p, s, 97, 100, 100, 114) { return true; }   // addr
    }
    if t.l == 5 {
        if eq5(p, s, 105, 115, 105, 122, 101) { return true; }   // isize
        if eq5(p, s, 117, 115, 105, 122, 101) { return true; }   // usize
    }
    return false;
}

// ncc's ty_compat, transliterated: the #[user] boundary first (so
// the byte-pointer wildcards cannot smuggle across), then exact
// name+depth, then integer inter-conversion, then the *u8/*void
// byte-pointer escape at equal depth.
fn tcompat(p: *u8, a: T, b: T) -> bool {
    if (a.pt > 0 || b.pt > 0) && a.us != b.us { return false; }
    if a.l > 0 && b.l > 0 && a.pt == b.pt && span_eq(p, a.s, a.l, b.s, b.l) { return true; }
    if is_int_ty(p, a) && is_int_ty(p, b) { return true; }
    if a.pt > 0 && b.pt > 0 && a.pt == b.pt {
        if eq2(p, a.s, 117, 56) && a.l == 2 { return true; }     // u8
        if eq2(p, b.s, 117, 56) && b.l == 2 { return true; }
        if a.l == 4 && eq4(p, a.s, 118, 111, 105, 100) { return true; }   // void
        if b.l == 4 && eq4(p, b.s, 118, 111, 105, 100) { return true; }
    }
    return false;
}

// ncc's ty_str, as prints: "#[user] " prefix, one '*' per level,
// the name ("void" when absent).
#[caps(syscall)]
fn ty_put(p: *u8, st: *i64, t: T) {
    if t.us == 1 { put("#[user] "); }
    mut q := 0;
    while q < t.pt { put("*"); q = q + 1; }
    if t.l > 0 { put_span(p, t.s, t.l); }
    if t.l == 0 { put_span(p, st[44] + 15, 4); }   // void
}

// A parsed type, by value: ptrs, is_user, and the name's span.
struct T { pt: i64, us: i64, s: i64, l: i64 }

// ncc's parse_type: [#[user]] [raw] *... name. Rung 1 checks no
// types; the tokens still have to be consumed correctly.
fn pty(p: *u8, n: i64, st: *i64) -> T {
    mut us := 0;
    if acc(p, n, st, 31) { us = 1; }       // #[user]
    if ck(st, 19) { adv(p, n, st); }       // raw (lowers identically)
    mut pt := 0;
    mut going := true;
    while going {
        going = false;
        if ck(st, 49) { adv(p, n, st); pt = pt + 1; going = true; }
    }
    if !ck(st, 7) { perr(st); return T{ pt: 0, us: 0, s: 0, l: 0 }; }
    s := st[26];
    l := st[27];
    adv(p, n, st);
    T{ pt: pt, us: us, s: s, l: l }
}

// ---- the expression ladder: parse and BUILD, node indexes up ---- //

fn pexpr(p: *u8, n: i64, st: *i64) -> i64 {
    return por(p, n, st);
}

// Interpolation: hole expressions become a child list; the text
// fragments and format specs are consumed but not kept (checking
// needs the holes, not the text).
#[caps(syscall)]
fn pinterp(p: *u8, n: i64, st: *i64) -> i64 {
    hx := sys_sbrk(256) as *i64;           // hole scratch (16 deep max)
    mut nh := 0;
    ln := st[25];
    adv(p, n, st);                         // past the HEAD text
    mut going := true;
    while going {
        hx[nh] = pexpr(p, n, st);          // the hole, as a node
        nh = nh + 1;
        if acc(p, n, st, 43) {             // ':' format spec (one ident)
            if !ck(st, 7) { perr(st); return 0; }
            adv(p, n, st);
        }
        if !ck(st, 6) { perr(st); return 0; }    // T_INTERP_R
        adv(p, n, st);
        if ck(st, 4) { adv(p, n, st); continue; }     // MID
        if ck(st, 5) { adv(p, n, st); going = false; continue; }   // TAIL
        perr(st);
        return 0;
    }
    ast := st[36];
    mut q := 0;
    while q < nh { ladd(st, hx[q]); q = q + 1; }
    return nnew(st, 4, ast, nh, 0, ln, 0, 0);
}

#[caps(syscall)]
fn pprimary(p: *u8, n: i64, st: *i64) -> i64 {
    if ck(st, 1) {                         // int
        v := st[26];
        ln := st[25];
        adv(p, n, st);
        return nnew(st, 1, v, 0, 0, ln, 0, 0);
    }
    if ck(st, 20) || ck(st, 21) {          // true / false
        mut v := 0;
        if ck(st, 20) { v = 1; }
        ln := st[25];
        adv(p, n, st);
        return nnew(st, 2, v, 0, 0, ln, 0, 0);
    }
    if ck(st, 2) {                         // plain string
        c := st[26];
        ln := st[25];
        adv(p, n, st);
        return nnew(st, 3, c, 0, 0, ln, 0, 0);
    }
    if ck(st, 3) {                         // interpolation HEAD
        return pinterp(p, n, st);
    }
    if ck(st, 37) {                        // '(': parens re-enable slits
        adv(p, n, st);
        save := st[32];
        st[32] = 0;
        h := pexpr(p, n, st);
        st[32] = save;
        if !ck(st, 38) { perr(st); return 0; }
        adv(p, n, st);
        return h;
    }
    if ck(st, 7) {                         // a name, or Name{ ... }
        ns := st[26];
        nl := st[27];
        ln := st[25];
        adv(p, n, st);
        if ck(st, 39) && st[32] == 0 {     // struct literal: field
            adv(p, n, st);                 // names AND values (3-word
            vx := sys_sbrk(768) as *i64;   // records: span + value)
            mut na := 0;
            mut more := !ck(st, 40);
            while more {
                more = false;
                if ck(st, 40) { continue; }    // trailing comma
                if !ck(st, 7) { perr(st); return 0; }
                vx[na * 3] = st[26];
                vx[na * 3 + 1] = st[27];
                adv(p, n, st);
                if !ck(st, 43) { perr(st); return 0; }
                adv(p, n, st);
                vx[na * 3 + 2] = pexpr(p, n, st);
                na = na + 1;
                if acc(p, n, st, 41) { more = true; }
            }
            if !ck(st, 40) { perr(st); return 0; }
            adv(p, n, st);
            ast := st[36];
            mut q := 0;
            while q < na * 3 { ladd(st, vx[q]); q = q + 1; }
            return nnew(st, 11, ast, 0, na, ln, ns, nl);
        }
        return nnew(st, 5, 0, 0, 0, ln, ns, nl);
    }
    perr(st);
    return 0;
}

// Postfix: same lookahead dance as parse.n — a variant literal needs
// the path by NAME, so `Name . Name {` is peeled before the primary.
#[caps(syscall)]
fn ppostfix(p: *u8, n: i64, st: *i64) -> i64 {
    if ck(st, 7) && ck2(st, 68) {
        ns := st[26];
        nl := st[27];
        ln := st[25];
        adv(p, n, st);                     // the name
        adv(p, n, st);                     // '.'
        if !ck(st, 7) { perr(st); return 0; }
        fs := st[26];
        fl := st[27];
        adv(p, n, st);                     // the field name
        if ck(st, 39) && st[32] == 0 {     // Enum.Variant{ ... }
            adv(p, n, st);
            vx := sys_sbrk(512) as *i64;
            mut na := 0;
            mut more := !ck(st, 40);
            while more {
                more = false;
                if ck(st, 40) { continue; }
                if !ck(st, 7) { perr(st); return 0; }
                adv(p, n, st);
                if !ck(st, 43) { perr(st); return 0; }
                adv(p, n, st);
                vx[na] = pexpr(p, n, st);
                na = na + 1;
                if acc(p, n, st, 41) { more = true; }
            }
            if !ck(st, 40) { perr(st); return 0; }
            adv(p, n, st);
            ast := st[36];
            mut q := 0;
            while q < na { ladd(st, vx[q]); q = q + 1; }
            el := nnew(st, 12, ast, 0, na, ln, ns, nl);
            return ppostfix_tail(p, n, st, el);
        }
        base := nnew(st, 5, 0, 0, 0, ln, ns, nl);
        h := pfield_or_call(p, n, st, base, fs, fl);
        return ppostfix_tail(p, n, st, h);
    }
    h2 := pprimary(p, n, st);
    return ppostfix_tail(p, n, st, h2);
}

// The postfix loop AFTER the head expression is built.
#[caps(syscall)]
fn ppostfix_tail(p: *u8, n: i64, st: *i64, h0: i64) -> i64 {
    mut h := h0;
    mut going := true;
    while going {
        going = false;
        if ck(st, 68) {                    // '.' field or method
            adv(p, n, st);
            if !ck(st, 7) { perr(st); return 0; }
            fs := st[26];
            fl := st[27];
            adv(p, n, st);
            h = pfield_or_call(p, n, st, h, fs, fl);
            going = true;
            continue;
        }
        if ck(st, 37) {                    // '(': a call on the head
            ln := st[25];
            adv(p, n, st);
            ax := sys_sbrk(512) as *i64;   // arg scratch (nested calls
            mut na := 0;                   // interleave the list arena)
            mut more := !ck(st, 38);
            while more {
                more = false;
                ax[na] = pexpr(p, n, st);
                na = na + 1;
                if acc(p, n, st, 41) { more = true; }
            }
            if !ck(st, 38) { perr(st); return 0; }
            adv(p, n, st);
            ast := st[36];
            mut q := 0;
            while q < na { ladd(st, ax[q]); q = q + 1; }
            h = nnew(st, 6, h, ast, na, ln, 0, 0);
            going = true;
            continue;
        }
        if ck(st, 34) {                    // '[' index ']'
            adv(p, n, st);
            ix := pexpr(p, n, st);
            if !ck(st, 35) { perr(st); return 0; }
            adv(p, n, st);
            h = nnew(st, 13, h, ix, 0, 0, 0, 0);
            going = true;
            continue;
        }
    }
    return h;
}

// After base + '.' + name: a call makes the field node the callee
// (ncc's method-call shape); a plain read is just the field node.
#[caps(syscall)]
fn pfield_or_call(p: *u8, n: i64, st: *i64, base: i64, fs: i64, fl: i64) -> i64 {
    if ck(st, 37) {                        // method call
        ln := st[25];
        fld := nnew(st, 7, base, 0, 0, ln, fs, fl);
        adv(p, n, st);
        ax := sys_sbrk(512) as *i64;
        mut na := 0;
        mut more := !ck(st, 38);
        while more {
            more = false;
            ax[na] = pexpr(p, n, st);
            na = na + 1;
            if acc(p, n, st, 41) { more = true; }
        }
        if !ck(st, 38) { perr(st); return 0; }
        adv(p, n, st);
        ast := st[36];
        mut q := 0;
        while q < na { ladd(st, ax[q]); q = q + 1; }
        return nnew(st, 6, fld, ast, na, ln, 0, 0);
    }
    ln2 := st[25];
    return nnew(st, 7, base, 0, 0, ln2, fs, fl);
}

fn punary(p: *u8, n: i64, st: *i64) -> i64 {
    if ck(st, 48) {                        // unary '-'
        ln := st[25];
        adv(p, n, st);
        h := punary(p, n, st);
        return nnew(st, 8, h, 0, 48, ln, 0, 0);
    }
    if ck(st, 60) {                        // '!'
        ln := st[25];
        adv(p, n, st);
        h2 := punary(p, n, st);
        return nnew(st, 8, h2, 0, 60, ln, 0, 0);
    }
    return ppostfix(p, n, st);
}

fn pcast(p: *u8, n: i64, st: *i64) -> i64 {
    mut h := punary(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 18) {                    // 'as' TYPE — the node carries
            ln := st[25];                  // the whole T: b=ptrs, c=user,
            adv(p, n, st);                 // span=name (casts are the
            t := pty(p, n, st);            // authoritative type source)
            h = nnew(st, 10, h, t.pt, t.us, ln, t.s, t.l);
            going = true;
        }
    }
    return h;
}

fn pmul(p: *u8, n: i64, st: *i64) -> i64 {
    mut h := pcast(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 49) { ln := st[25]; adv(p, n, st); r := pcast(p, n, st); h = nnew(st, 9, h, r, 49, ln, 0, 0); going = true; continue; }
        if ck(st, 50) { ln := st[25]; adv(p, n, st); r := pcast(p, n, st); h = nnew(st, 9, h, r, 50, ln, 0, 0); going = true; continue; }
        if ck(st, 51) { ln := st[25]; adv(p, n, st); r := pcast(p, n, st); h = nnew(st, 9, h, r, 51, ln, 0, 0); going = true; }
    }
    return h;
}

fn padd2(p: *u8, n: i64, st: *i64) -> i64 {
    mut h := pmul(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 47) { ln := st[25]; adv(p, n, st); r := pmul(p, n, st); h = nnew(st, 9, h, r, 47, ln, 0, 0); going = true; continue; }
        if ck(st, 48) { ln := st[25]; adv(p, n, st); r := pmul(p, n, st); h = nnew(st, 9, h, r, 48, ln, 0, 0); going = true; }
    }
    return h;
}

fn pshift(p: *u8, n: i64, st: *i64) -> i64 {
    mut h := padd2(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 66) { ln := st[25]; adv(p, n, st); r := padd2(p, n, st); h = nnew(st, 9, h, r, 66, ln, 0, 0); going = true; continue; }
        if ck(st, 67) { ln := st[25]; adv(p, n, st); r := padd2(p, n, st); h = nnew(st, 9, h, r, 67, ln, 0, 0); going = true; }
    }
    return h;
}

fn pband(p: *u8, n: i64, st: *i64) -> i64 {
    mut h := pshift(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 63) { ln := st[25]; adv(p, n, st); r := pshift(p, n, st); h = nnew(st, 9, h, r, 63, ln, 0, 0); going = true; }
    }
    return h;
}

fn pbxor(p: *u8, n: i64, st: *i64) -> i64 {
    mut h := pband(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 65) { ln := st[25]; adv(p, n, st); r := pband(p, n, st); h = nnew(st, 9, h, r, 65, ln, 0, 0); going = true; }
    }
    return h;
}

fn pbor(p: *u8, n: i64, st: *i64) -> i64 {
    mut h := pbxor(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 64) { ln := st[25]; adv(p, n, st); r := pbxor(p, n, st); h = nnew(st, 9, h, r, 64, ln, 0, 0); going = true; }
    }
    return h;
}

fn pcmp(p: *u8, n: i64, st: *i64) -> i64 {
    mut h := pbor(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 54) { ln := st[25]; adv(p, n, st); r := pbor(p, n, st); h = nnew(st, 9, h, r, 54, ln, 0, 0); going = true; continue; }
        if ck(st, 55) { ln := st[25]; adv(p, n, st); r := pbor(p, n, st); h = nnew(st, 9, h, r, 55, ln, 0, 0); going = true; continue; }
        if ck(st, 56) { ln := st[25]; adv(p, n, st); r := pbor(p, n, st); h = nnew(st, 9, h, r, 56, ln, 0, 0); going = true; continue; }
        if ck(st, 57) { ln := st[25]; adv(p, n, st); r := pbor(p, n, st); h = nnew(st, 9, h, r, 57, ln, 0, 0); going = true; continue; }
        if ck(st, 58) { ln := st[25]; adv(p, n, st); r := pbor(p, n, st); h = nnew(st, 9, h, r, 58, ln, 0, 0); going = true; continue; }
        if ck(st, 59) { ln := st[25]; adv(p, n, st); r := pbor(p, n, st); h = nnew(st, 9, h, r, 59, ln, 0, 0); going = true; }
    }
    return h;
}

fn pand(p: *u8, n: i64, st: *i64) -> i64 {
    mut h := pcmp(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 61) { ln := st[25]; adv(p, n, st); r := pcmp(p, n, st); h = nnew(st, 9, h, r, 61, ln, 0, 0); going = true; }
    }
    return h;
}

fn por(p: *u8, n: i64, st: *i64) -> i64 {
    mut h := pand(p, n, st);
    mut going := true;
    while going {
        going = false;
        if ck(st, 62) { ln := st[25]; adv(p, n, st); r := pand(p, n, st); h = nnew(st, 9, h, r, 62, ln, 0, 0); going = true; }
    }
    return h;
}

// ---- statements + blocks --------------------------------------- //

fn pif(p: *u8, n: i64, st: *i64) -> i64 {
    ln := st[25];
    adv(p, n, st);                         // 'if'
    st[32] = 1;
    c := pexpr(p, n, st);
    st[32] = 0;
    t := pblock(p, n, st);
    mut e := 0;
    if acc(p, n, st, 14) {                 // else, or else-if (the else
        mut inner := 0;                    // slot then holds an if node)
        if ck(st, 13) {
            inner = 1;
            e = pif(p, n, st);
        }
        if inner == 0 { e = pblock(p, n, st); }
    }
    return nnew(st, 25, c, t, e, ln, 0, 0);
}

// One block: statements chain through the next-link slot; the tail
// expression rides the block node. Each dispatcher branch fills sn,
// and the `sn == 0` guards keep one statement to one branch.
fn pblock(p: *u8, n: i64, st: *i64) -> i64 {
    if !ck(st, 39) { perr(st); return 0; }
    bln := st[25];
    adv(p, n, st);
    mut first := 0;
    mut last := 0;
    mut cnt := 0;
    mut tail := 0;
    mut istail := 0;
    mut going := true;
    while going {
        if ck(st, 40) { going = false; continue; }
        if ck(st, 0) { perr(st); return 0; }
        mut sn := 0;
        if ck(st, 11) || (ck(st, 7) && ck2(st, 44)) {   // [mut] name :=
            ln := st[25];
            mut im := 0;
            if acc(p, n, st, 11) { im = 1; }
            if !ck(st, 7) { perr(st); return 0; }
            is := st[26];
            il := st[27];
            adv(p, n, st);
            if !ck(st, 44) { perr(st); return 0; }
            adv(p, n, st);
            if ck(st, 25) { perr(st); return 0; }   // := match — later rung
            rhs := pexpr(p, n, st);
            tr := acc(p, n, st, 69);       // x := e?; (try — later rung)
            if !ck(st, 42) { perr(st); return 0; }
            adv(p, n, st);
            sn = nnew(st, 20, rhs, 0, im, ln, is, il);
        }
        if sn == 0 && ck(st, 12) {         // return [e] ;
            ln := st[25];
            adv(p, n, st);
            if ck(st, 25) { perr(st); return 0; }   // return match — later
            mut re := 0;
            mut bare := 0;
            if ck(st, 42) { adv(p, n, st); bare = 1; }
            if bare == 0 {
                re = pexpr(p, n, st);
                if !ck(st, 42) { perr(st); return 0; }
                adv(p, n, st);
            }
            sn = nnew(st, 22, re, 0, 0, ln, 0, 0);
        }
        if sn == 0 && ck(st, 16) {         // break ;
            ln := st[25];
            adv(p, n, st);
            if !ck(st, 42) { perr(st); return 0; }
            adv(p, n, st);
            sn = nnew(st, 26, 0, 0, 0, ln, 0, 0);
        }
        if sn == 0 && ck(st, 17) {         // continue ;
            ln := st[25];
            adv(p, n, st);
            if !ck(st, 42) { perr(st); return 0; }
            adv(p, n, st);
            sn = nnew(st, 27, 0, 0, 0, ln, 0, 0);
        }
        if sn == 0 && ck(st, 23) {         // defer e ;
            ln := st[25];
            adv(p, n, st);
            de := pexpr(p, n, st);
            if !ck(st, 42) { perr(st); return 0; }
            adv(p, n, st);
            sn = nnew(st, 28, de, 0, 0, ln, 0, 0);
        }
        if sn == 0 && ck(st, 15) {         // while cond { }
            ln := st[25];
            adv(p, n, st);
            st[32] = 1;
            c := pexpr(p, n, st);
            st[32] = 0;
            b := pblock(p, n, st);
            sn = nnew(st, 24, c, b, 0, ln, 0, 0);
        }
        if sn == 0 && ck(st, 13) {         // if
            sn = pif(p, n, st);
        }
        if sn == 0 && ck(st, 25) {         // match — a later rung
            perr(st);
            return 0;
        }
        if sn == 0 && ck(st, 28) {         // for name in a..b { }
            ln := st[25];
            adv(p, n, st);
            if !ck(st, 7) { perr(st); return 0; }
            fs2 := st[26];
            fl2 := st[27];
            adv(p, n, st);
            if !ck(st, 29) { perr(st); return 0; }   // 'in'
            adv(p, n, st);
            st[32] = 1;
            lo := pexpr(p, n, st);
            if !ck(st, 30) { perr(st); return 0; }   // '..'
            adv(p, n, st);
            hi := pexpr(p, n, st);
            st[32] = 0;
            b2 := pblock(p, n, st);
            sn = nnew(st, 30, lo, hi, b2, ln, fs2, fl2);
        }
        if sn == 0 {                       // expression, assignment, tail
            ln := st[25];
            h := pexpr(p, n, st);
            mut done := 0;
            if ck(st, 46) || ck(st, 52) || ck(st, 53) {
                mut op := 0;               // 0 '=', 1 '+=', 2 '-='
                if ck(st, 52) { op = 1; }
                if ck(st, 53) { op = 2; }
                adv(p, n, st);
                if ck(st, 25) { perr(st); return 0; }   // = match — later
                rhs2 := pexpr(p, n, st);
                tr2 := acc(p, n, st, 69);
                if !ck(st, 42) { perr(st); return 0; }
                adv(p, n, st);
                sn = nnew(st, 21, h, rhs2, op, ln, 0, 0);
                done = 1;
            }
            if done == 0 && acc(p, n, st, 69) {     // e? ;
                if !ck(st, 42) { perr(st); return 0; }
                adv(p, n, st);
                sn = nnew(st, 23, h, 0, 1, ln, 0, 0);
                done = 1;
            }
            if done == 0 && acc(p, n, st, 42) {     // e ;
                sn = nnew(st, 23, h, 0, 0, ln, 0, 0);
                done = 1;
            }
            if done == 0 {                 // the block tail
                if !ck(st, 40) { perr(st); return 0; }
                adv(p, n, st);
                tail = h;
                istail = 1;
                going = false;
                continue;
            }
        }
        if sn == 0 { perr(st); return 0; }
        if first == 0 { first = sn; }
        if last > 0 {
            nd := st[33] as *i64;
            nd[last * 8 + 7] = sn;
        }
        last = sn;
        cnt = cnt + 1;
    }
    if istail == 0 { adv(p, n, st); }      // '}' (the tail path ate it)
    return nnew(st, 40, first, tail, cnt, bln, 0, 0);
}

// ---- items ------------------------------------------------------ //

// Params fill a caller-provided arena: name span + T, 6 words each.
// Returns the count. (parse.n's, unchanged.)
fn pparams(p: *u8, n: i64, st: *i64, ps: *i64) -> i64 {
    if !ck(st, 37) { perr(st); return 0; }
    adv(p, n, st);
    mut np := 0;
    mut more := !ck(st, 38);
    while more {
        more = false;
        if !ck(st, 7) { perr(st); return np; }
        ps[np * 6] = st[26];
        ps[np * 6 + 1] = st[27];
        adv(p, n, st);
        if !ck(st, 43) { perr(st); return np; }
        adv(p, n, st);
        t := pty(p, n, st);
        ps[np * 6 + 2] = t.pt;
        ps[np * 6 + 3] = t.us;
        ps[np * 6 + 4] = t.s;
        ps[np * 6 + 5] = t.l;
        np = np + 1;
        if acc(p, n, st, 41) { more = true; }
    }
    if !ck(st, 38) { perr(st); return np; }
    adv(p, n, st);
    return np;
}

// Skip one top-level item: advance to its opening '{', then count
// braces to the close. Safe: string-interpolation braces never
// tokenize as LB/RB. (parse.n's, unchanged.)
fn skip_item(p: *u8, n: i64, st: *i64) {
    mut going := true;
    while going {
        if ck(st, 0) { return; }
        if ck(st, 39) { going = false; continue; }
        adv(p, n, st);
    }
    adv(p, n, st);
    mut d := 1;
    while d > 0 {
        if ck(st, 0) { return; }
        if ck(st, 39) { d = d + 1; }
        if ck(st, 40) { d = d - 1; }
        adv(p, n, st);
    }
}

// struct Name { f: ty, ... } — parse.n's pstruct accreted back,
// transformed: fields land in the struct table instead of a D line.
// The #[drop]/own attributes were consumed by the item loop; their
// semantics (destructors, ownership) are later rungs.
fn pstruct(p: *u8, n: i64, st: *i64, ps: *i64) {
    if !ck(st, 7) { perr(st); return; }
    ns := st[26];
    nl := st[27];
    adv(p, n, st);
    if !ck(st, 39) { perr(st); return; }
    adv(p, n, st);
    mut nf := 0;
    mut more := !ck(st, 40);
    while more {
        more = false;
        if !ck(st, 7) { perr(st); return; }
        ps[nf * 6] = st[26];
        ps[nf * 6 + 1] = st[27];
        adv(p, n, st);
        if !ck(st, 43) { perr(st); return; }
        adv(p, n, st);
        t := pty(p, n, st);
        ps[nf * 6 + 2] = t.pt;
        ps[nf * 6 + 3] = t.us;
        ps[nf * 6 + 4] = t.s;
        ps[nf * 6 + 5] = t.l;
        nf = nf + 1;
        if acc(p, n, st, 41) {
            if !ck(st, 40) { more = true; }
        }
    }
    if !ck(st, 40) { perr(st); return; }
    adv(p, n, st);
    fst := st[36];
    mut q := 0;
    while q < nf {
        mut w := 0;
        while w < 6 { ladd(st, ps[q * 6 + w]); w = w + 1; }
        q = q + 1;
    }
    sadd(st, ns, nl, nf, fst);
}

// extern syscall { fn name(params) [-> ty] = NUM [;] ... } — each
// binding becomes a table record (no body).
fn pextern(p: *u8, n: i64, st: *i64, caps: i64, ps: *i64) {
    if !ck(st, 9) { perr(st); return; }    // 'syscall'
    adv(p, n, st);
    if !ck(st, 39) { perr(st); return; }
    adv(p, n, st);
    mut more := ck(st, 10);
    while more {
        more = false;
        adv(p, n, st);                     // 'fn'
        if !ck(st, 7) { perr(st); return; }
        xs := st[26];
        xl := st[27];
        adv(p, n, st);
        np := pparams(p, n, st, ps);
        mut rt := T{ pt: 0, us: 0, s: 0, l: 0 };
        if acc(p, n, st, 45) { rt = pty(p, n, st); }
        if !ck(st, 46) { perr(st); return; }
        adv(p, n, st);
        if !ck(st, 1) { perr(st); return; }
        adv(p, n, st);                     // the syscall number
        if ck(st, 42) { adv(p, n, st); }   // optional ';'
        pst := st[36];
        mut q := 0;
        while q < np {                     // full 6-word param records
            mut w := 0;                    // (span + T), then 4 words of
            while w < 6 { ladd(st, ps[q * 6 + w]); w = w + 1; }
            q = q + 1;                     // return type
        }
        ladd(st, rt.pt);
        ladd(st, rt.us);
        ladd(st, rt.s);
        ladd(st, rt.l);
        fadd(st, xs, xl, np, caps, 0, pst, 0);
        if ck(st, 10) { more = true; }
    }
    if !ck(st, 40) { perr(st); return; }
    adv(p, n, st);
}

// fn name(params) [-> ty] { body } — params copy into the list arena
// BEFORE the body parses (the body's own lists must not interleave),
// then the body tree and the table record.
fn pfn(p: *u8, n: i64, st: *i64, caps: i64, ps: *i64) {
    if !ck(st, 7) { perr(st); return; }
    fs := st[26];
    fl := st[27];
    if cname_fn(p, st, fs, fl, st[25]) { return; }   // ncc dies at the
    adv(p, n, st);                                   // name — so do we
    np := pparams(p, n, st, ps);
    mut rt := T{ pt: 0, us: 0, s: 0, l: 0 };
    if acc(p, n, st, 45) { rt = pty(p, n, st); }
    pst := st[36];
    mut q := 0;
    while q < np {                         // full 6-word param records,
        mut w := 0;                        // then the return type — all
        while w < 6 { ladd(st, ps[q * 6 + w]); w = w + 1; }
        q = q + 1;                         // BEFORE the body parses (its
    }                                      // lists must not interleave)
    ladd(st, rt.pt);
    ladd(st, rt.us);
    ladd(st, rt.s);
    ladd(st, rt.l);
    body := pblock(p, n, st);
    fadd(st, fs, fl, np, caps, body, pst, 1);
}

// ONE pass over the whole token stream — ncc's own shape. Externs
// and fns parse for real; struct/enum/impl items brace-skip (their
// checking rows arrive with the decl-table rung).
fn pitems(p: *u8, n: i64, st: *i64, ps: *i64) {
    mut going := true;
    while going {
        if st[41] == 1 { going = false; continue; }   // a parse-time
        if ck(st, 0) { going = false; continue; }     // error already won
        mut caps := 0;
        if ck(st, 33) { adv(p, n, st); }   // #[drop(fn)] rides a struct
        if acc(p, n, st, 32) { caps = 1; } // #[caps(syscall)]
        ow := acc(p, n, st, 36);           // 'own' — its struct skips
        if ck(st, 22) {                    // struct: a real parse now —
            adv(p, n, st);                 // the table rung landed
            pstruct(p, n, st, ps);
            continue;
        }
        if ck(st, 24) { skip_item(p, n, st); continue; }   // enum
        if ck(st, 27) { skip_item(p, n, st); continue; }   // impl
        if ck(st, 8) {                     // extern
            adv(p, n, st);
            pextern(p, n, st, caps, ps);
            continue;
        }
        if ck(st, 10) {                    // fn
            adv(p, n, st);
            pfn(p, n, st, caps, ps);
            continue;
        }
        perr(st);
        going = false;
    }
}

// ---- the checker ------------------------------------------------ //
// A walk over the tree with the live name table — ncc's discipline:
// the check runs statement by statement, names resolve at their
// textual position, the first error prints and the flag stops
// everything after it (ncc dies on its first error).

#[caps(syscall)]
fn cexpr(p: *u8, st: *i64, i: i64) {
    if st[41] == 1 { return; }
    if i == 0 { return; }
    nd := st[33] as *i64;
    al := st[35] as *i64;
    k := nd[i * 8];
    if k == 5 {                            // path: resolve or die
        v := vfind(p, st, nd[i * 8 + 5], nd[i * 8 + 6]);
        if v < 0 {
            ln := nd[i * 8 + 4];
            put("{ln}: undeclared variable '");
            put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
            put("'\n");
            st[41] = 1;
        }
        return;
    }
    if k == 6 {                            // call
        cal := nd[i * 8 + 1];
        ln := nd[i * 8 + 4];
        na := nd[i * 8 + 3];
        if nd[cal * 8] == 5 {              // named callee: the fn table
            fi := ffind(p, st, nd[cal * 8 + 5], nd[cal * 8 + 6]);
            if fi < 0 {
                put("{ln}: unknown function '");
                put_span(p, nd[cal * 8 + 5], nd[cal * 8 + 6]);
                put("'\n");
                st[41] = 1;
                return;
            }
            ft := st[37] as *i64;
            if ft[fi * 8 + 6] == 0 && ft[fi * 8 + 3] == 1 && st[42] == 0 {
                put("{ln}: '");           // ncc's xfn_caps is XFNS-only:
                put_span(p, nd[cal * 8 + 5], nd[cal * 8 + 6]);
                put("' requires the syscall capability — mark the calling function #[caps(syscall)]\n");
                st[41] = 1;               // fn-to-fn calls never gate;
                return;                   // order: exists, caps, arity
            }
            np := ft[fi * 8 + 2];
            if na != np {
                put("{ln}: '");
                put_span(p, nd[cal * 8 + 5], nd[cal * 8 + 6]);
                put("' takes {np} argument(s), got {na}\n");
                st[41] = 1;
                return;
            }
            mut q := 0;
            while q < na {                 // per argument: resolve, then
                cexpr(p, st, al[nd[i * 8 + 2] + q]);   // type-check —
                if st[41] == 1 { return; } // ncc's per-arg order
                at := cinfer(p, st, al[nd[i * 8 + 2] + q]);
                pt2 := fpty(st, fi, q);
                if !tcompat(p, at, pt2) {
                    qq := q + 1;
                    put("{ln}: argument {qq} to '");
                    put_span(p, nd[cal * 8 + 5], nd[cal * 8 + 6]);
                    put("': expected ");
                    ty_put(p, st, pt2);
                    put(", got ");
                    ty_put(p, st, at);
                    put("\n");
                    st[41] = 1;
                    return;
                }
                q = q + 1;
            }
            return;
        }
        if nd[cal * 8] == 7 {              // method call: ncc checks the
            cexpr(p, st, nd[cal * 8 + 1]); // RECEIVER, not the field node
        }                                  // (dispatch is a later rung)
        if nd[cal * 8] != 7 { cexpr(p, st, cal); }
        mut q2 := 0;
        while q2 < na {
            cexpr(p, st, al[nd[i * 8 + 2] + q2]);
            q2 = q2 + 1;
        }
        return;
    }
    if k == 7 {                            // field read: base resolves,
        cexpr(p, st, nd[i * 8 + 1]);       // then ncc's three arms —
        if st[41] == 1 { return; }         // str, struct, has-no-fields
        bt := cinfer(p, st, nd[i * 8 + 1]);
        ln2 := nd[i * 8 + 4];
        if span_is(p, bt, st[44] + 7, 3) {
            isp := nd[i * 8 + 6] == 3 && eq3(p, nd[i * 8 + 5], 112, 116, 114);
            isl := nd[i * 8 + 6] == 3 && eq3(p, nd[i * 8 + 5], 108, 101, 110);
            if !isp && !isl {
                put("{ln2}: str has no field '");
                put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
                put("' (only .ptr and .len)\n");
                st[41] = 1;
            }
            return;
        }
        if bt.pt == 0 && bt.l > 0 {
            si := sfind(p, st, bt.s, bt.l);
            if si >= 0 {
                sa := st[49] as *i64;
                mut ok := 0;
                mut q5 := 0;
                while q5 < sa[si * 4 + 2] {
                    r := sa[si * 4 + 3] + q5 * 6;
                    if span_eq(p, al[r], al[r + 1], nd[i * 8 + 5], nd[i * 8 + 6]) { ok = 1; }
                    q5 = q5 + 1;
                }
                if ok == 0 {
                    put("{ln2}: struct '");
                    put_span(p, bt.s, bt.l);
                    put("' has no field '");
                    put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
                    put("'\n");
                    st[41] = 1;
                }
                return;
            }
        }
        put("{ln2}: ");
        ty_put(p, st, bt);
        put(" has no fields\n");
        st[41] = 1;
        return;
    }
    if k == 8 { cexpr(p, st, nd[i * 8 + 1]); return; }    // unary
    if k == 9 {                            // binary: left, then right
        cexpr(p, st, nd[i * 8 + 1]);
        cexpr(p, st, nd[i * 8 + 2]);
        return;
    }
    if k == 10 { cexpr(p, st, nd[i * 8 + 1]); return; }   // cast
    if k == 13 {                           // index: base, then index
        cexpr(p, st, nd[i * 8 + 1]);
        cexpr(p, st, nd[i * 8 + 2]);
        return;
    }
    if k == 4 {                            // interp: every hole
        mut q3 := 0;
        while q3 < nd[i * 8 + 2] {
            cexpr(p, st, al[nd[i * 8 + 1] + q3]);
            q3 = q3 + 1;
        }
        return;
    }
    if k == 11 {                           // struct literal: ncc's order —
        ln3 := nd[i * 8 + 4];              // known struct, every declared
        na2 := nd[i * 8 + 3];              // field exactly once, no extra
        si2 := sfind(p, st, nd[i * 8 + 5], nd[i * 8 + 6]);   // names, then
        if si2 < 0 {                       // per-value resolve + type
            put("{ln3}: unknown struct '");
            put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
            put("'\n");
            st[41] = 1;
            return;
        }
        sa2 := st[49] as *i64;
        nf := sa2[si2 * 4 + 2];
        lst := nd[i * 8 + 1];
        mut q4 := 0;
        while q4 < nf {
            r2 := sa2[si2 * 4 + 3] + q4 * 6;
            mut seen := 0;
            mut j := 0;
            while j < na2 {
                if span_eq(p, al[lst + j * 3], al[lst + j * 3 + 1], al[r2], al[r2 + 1]) { seen = seen + 1; }
                j = j + 1;
            }
            if seen != 1 {
                put("{ln3}: literal for '");
                put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
                put("' must initialize field '");
                put_span(p, al[r2], al[r2 + 1]);
                put("' exactly once\n");
                st[41] = 1;
                return;
            }
            q4 = q4 + 1;
        }
        if na2 != nf {
            put("{ln3}: literal for '");
            put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
            put("' names a field it does not have\n");
            st[41] = 1;
            return;
        }
        mut j2 := 0;
        while j2 < na2 {
            vv := al[lst + j2 * 3 + 2];
            cexpr(p, st, vv);
            if st[41] == 1 { return; }
            at2 := cinfer(p, st, vv);
            mut dt := t_i64(st);
            mut q6 := 0;
            while q6 < nf {
                r3 := sa2[si2 * 4 + 3] + q6 * 6;
                if span_eq(p, al[r3], al[r3 + 1], al[lst + j2 * 3], al[lst + j2 * 3 + 1]) { dt = sfty(st, si2, q6); }
                q6 = q6 + 1;
            }
            if !tcompat(p, at2, dt) {
                put("{ln3}: field '");
                put_span(p, al[lst + j2 * 3], al[lst + j2 * 3 + 1]);
                put("' of '");
                put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
                put("': expected ");
                ty_put(p, st, dt);
                put(", got ");
                ty_put(p, st, at2);
                put("\n");
                st[41] = 1;
                return;
            }
            j2 = j2 + 1;
        }
        return;
    }
    if k == 12 {                           // enum literal values (the
        mut q7 := 0;                       // enum table is a later rung)
        while q7 < nd[i * 8 + 3] {
            cexpr(p, st, al[nd[i * 8 + 1] + q7]);
            q7 = q7 + 1;
        }
        return;
    }
}

#[caps(syscall)]
fn cstmt(p: *u8, st: *i64, i: i64) {
    if st[41] == 1 { return; }
    if i == 0 { return; }
    nd := st[33] as *i64;
    k := nd[i * 8];
    if k == 20 {                           // let: check the rhs, infer
        cexpr(p, st, nd[i * 8 + 1]);       // its type, then bind
        if st[41] == 1 { return; }
        rt2 := cinfer(p, st, nd[i * 8 + 1]);
        if rt2.l == 0 {                    // a void call has no value
            ln := nd[i * 8 + 4];
            put("{ln}: cannot bind '");
            put_span(p, nd[i * 8 + 5], nd[i * 8 + 6]);
            put("' to an expression with no value\n");
            st[41] = 1;
            return;
        }
        vadd(st, nd[i * 8 + 5], nd[i * 8 + 6], nd[i * 8 + 3], rt2);
        return;
    }
    if k == 21 {                           // assign: lhs, rhs, the root
        cexpr(p, st, nd[i * 8 + 1]);       // judgments (str-index write,
        cexpr(p, st, nd[i * 8 + 2]);       // mut), then value/target
        if st[41] == 1 { return; }         // types — ncc's exact order
        mut r := nd[i * 8 + 1];            // field writes mutate the root
        while nd[r * 8] == 7 { r = nd[r * 8 + 1]; }
        if nd[r * 8] == 13 {               // element writes through a
            ibt := cinfer(p, st, nd[r * 8 + 1]);   // pointer are free;
            if span_is(p, ibt, st[44] + 7, 3) {    // str stays immutable
                ln := nd[i * 8 + 4];
                put("{ln}: cannot write through a str index — str is an immutable view of its text\n");
                st[41] = 1;
                return;
            }
        }
        if nd[r * 8] == 5 {
            v := vfind(p, st, nd[r * 8 + 5], nd[r * 8 + 6]);
            va := st[39] as *i64;
            if v >= 0 && va[v * 8 + 2] == 0 {
                ln := nd[i * 8 + 4];
                put("{ln}: cannot assign to immutable '");
                put_span(p, nd[r * 8 + 5], nd[r * 8 + 6]);
                put("' (declare it with 'mut')\n");
                st[41] = 1;
                return;
            }
        }
        lt := cinfer(p, st, nd[i * 8 + 1]);
        rt3 := cinfer(p, st, nd[i * 8 + 2]);
        if !tcompat(p, rt3, lt) {
            ln2 := nd[i * 8 + 4];
            put("{ln2}: cannot assign ");
            ty_put(p, st, rt3);
            put(" to a ");
            ty_put(p, st, lt);
            put(" target\n");
            st[41] = 1;
            return;
        }
        if nd[i * 8 + 3] != 0 && !is_int_ty(p, lt) {
            ln3 := nd[i * 8 + 4];
            put("{ln3}: '");
            if nd[i * 8 + 3] == 1 { put("+="); }
            if nd[i * 8 + 3] == 2 { put("-="); }
            put("' requires an integer target (got ");
            ty_put(p, st, lt);
            put(")\n");
            st[41] = 1;
        }
        return;
    }
    if k == 22 {                           // return: resolve the value,
        cexpr(p, st, nd[i * 8 + 1]);       // then ncc's three judgments
        if st[41] == 1 { return; }         // (never counts as no-type)
        rt4 := T{ pt: st[45], us: st[46], s: st[47], l: st[48] };
        nvr := rt4.l == 5 && eq5(p, rt4.s, 110, 101, 118, 101, 114);
        if nd[i * 8 + 1] > 0 {
            if rt4.l == 0 || nvr {
                ln := nd[i * 8 + 4];
                put("{ln}: 'return' with a value in a function with no return type\n");
                st[41] = 1;
                return;
            }
            vt := cinfer(p, st, nd[i * 8 + 1]);
            if !tcompat(p, vt, rt4) {
                ln2 := nd[i * 8 + 4];
                put("{ln2}: return type mismatch: expected ");
                ty_put(p, st, rt4);
                put(", got ");
                ty_put(p, st, vt);
                put("\n");
                st[41] = 1;
            }
            return;
        }
        if rt4.l > 0 && !nvr {
            ln3 := nd[i * 8 + 4];
            put("{ln3}: 'return' without a value in a function returning ");
            ty_put(p, st, rt4);
            put("\n");
            st[41] = 1;
        }
        return;
    }
    if k == 23 { cexpr(p, st, nd[i * 8 + 1]); return; }   // expr stmt
    if k == 24 {                           // while
        cexpr(p, st, nd[i * 8 + 1]);
        cblock(p, st, nd[i * 8 + 2]);
        return;
    }
    if k == 25 {                           // if: cond, then, else (the
        cexpr(p, st, nd[i * 8 + 1]);       // else slot may hold an if)
        cblock(p, st, nd[i * 8 + 2]);
        els := nd[i * 8 + 3];
        if els > 0 {
            if nd[els * 8] == 25 { cstmt(p, st, els); }
            if nd[els * 8] == 40 { cblock(p, st, els); }
        }
        return;
    }
    if k == 28 {                           // defer: the depth judgment
        if st[43] != 1 {                   // FIRST (ncc's S_DEFER order),
            ln := nd[i * 8 + 4];           // then the expression resolves
            put("{ln}: defer is only allowed in the function's outermost block\n");
            st[41] = 1;
            return;
        }
        cexpr(p, st, nd[i * 8 + 1]);
        return;
    }
    if k == 30 {                           // for: bounds, then the body
        cexpr(p, st, nd[i * 8 + 1]);       // with the loop var seeded
        cexpr(p, st, nd[i * 8 + 2]);       // (immutable) in its scope
        if st[41] == 1 { return; }
        vsave := st[40];
        vadd(st, nd[i * 8 + 5], nd[i * 8 + 6], 0, t_i64(st));
        cblock(p, st, nd[i * 8 + 3]);
        st[40] = vsave;
        return;
    }
}

// Block scope: record the name count on entry, truncate on exit —
// ncc's gen_block move.
#[caps(syscall)]
fn cblock(p: *u8, st: *i64, i: i64) {
    if st[41] == 1 { return; }
    if i == 0 { return; }
    nd := st[33] as *i64;
    vsave := st[40];
    st[43] = st[43] + 1;                   // ncc's BLOCK_DEPTH: 1 = the
    mut s := nd[i * 8 + 1];                // function's own block
    while s > 0 {
        cstmt(p, st, s);
        if st[41] == 1 { return; }
        s = nd[s * 8 + 7];
    }
    t := nd[i * 8 + 2];
    if t > 0 { cexpr(p, st, t); }
    st[43] = st[43] - 1;
    st[40] = vsave;
}

// One function: a fresh name table seeded with the params (params
// are immutable — ncc adds them with is_mut 0), then the body.
#[caps(syscall)]
fn cfn(p: *u8, st: *i64, fi: i64) {
    ft := st[37] as *i64;
    al := st[35] as *i64;
    st[40] = 0;
    st[42] = ft[fi * 8 + 3];               // CUR_FN_CAPS, ncc's reset
    st[43] = 0;                            // BLOCK_DEPTH, per function
    crt := frty(st, fi);                   // CUR_RET at st[45..48]
    st[45] = crt.pt;
    st[46] = crt.us;
    st[47] = crt.s;
    st[48] = crt.l;
    mut q := 0;
    while q < ft[fi * 8 + 2] {             // params: span + declared type
        r := ft[fi * 8 + 5] + q * 6;
        pt2 := T{ pt: al[r + 2], us: al[r + 3], s: al[r + 4], l: al[r + 5] };
        vadd(st, al[r], al[r + 1], 0, pt2);
        q = q + 1;
    }
    cblock(p, st, ft[fi * 8 + 4]);
}

// The recorded param type / return type of one fn-table record.
fn fpty(st: *i64, fi: i64, q: i64) -> T {
    ft := st[37] as *i64;
    al := st[35] as *i64;
    r := ft[fi * 8 + 5] + q * 6;
    T{ pt: al[r + 2], us: al[r + 3], s: al[r + 4], l: al[r + 5] }
}

fn frty(st: *i64, fi: i64) -> T {
    ft := st[37] as *i64;
    al := st[35] as *i64;
    r := ft[fi * 8 + 5] + ft[fi * 8 + 2] * 6;
    T{ pt: al[r], us: al[r + 1], s: al[r + 2], l: al[r + 3] }
}

// ncc's infer_type, transliterated: bottom-up, re-inferring on
// demand, i64 as the soft fallback (check.n's unresolved cases —
// struct fields, enum refs, method returns — fall back the same way
// until their tables land; the claimed rows never reach them).
#[caps(syscall)]
fn cinfer(p: *u8, st: *i64, i: i64) -> T {
    if i == 0 { return t_void(); }
    nd := st[33] as *i64;
    k := nd[i * 8];
    if k == 1 { return t_i64(st); }
    if k == 2 { return t_bool(st); }
    if k == 3 || k == 4 { return t_str(st); }
    if k == 5 {                            // path: the binding's type
        v := vfind(p, st, nd[i * 8 + 5], nd[i * 8 + 6]);
        if v >= 0 { return vty(st, v); }
        return t_i64(st);
    }
    if k == 6 {                            // call: the callee's return
        cal := nd[i * 8 + 1];
        if nd[cal * 8] == 5 {
            fi := ffind(p, st, nd[cal * 8 + 5], nd[cal * 8 + 6]);
            if fi >= 0 { return frty(st, fi); }
        }
        return t_i64(st);                  // methods: a later rung
    }
    if k == 7 {                            // field: str.ptr / str.len,
        bt := cinfer(p, st, nd[i * 8 + 1]);    // then the struct table
        if span_is(p, bt, st[44] + 7, 3) {                 // base is str
            if nd[i * 8 + 6] == 3 && eq3(p, nd[i * 8 + 5], 112, 116, 114) {
                return t_pu8(st);                          // .ptr
            }
            if nd[i * 8 + 6] == 3 && eq3(p, nd[i * 8 + 5], 108, 101, 110) {
                return t_u64(st);                          // .len
            }
        }
        if bt.pt == 0 && bt.l > 0 {
            si := sfind(p, st, bt.s, bt.l);
            if si >= 0 {
                sa := st[49] as *i64;
                al := st[35] as *i64;
                mut q := 0;
                while q < sa[si * 4 + 2] {
                    r := sa[si * 4 + 3] + q * 6;
                    if span_eq(p, al[r], al[r + 1], nd[i * 8 + 5], nd[i * 8 + 6]) {
                        return sfty(st, si, q);
                    }
                    q = q + 1;
                }
            }
        }
        return t_i64(st);                  // enums/methods: later rungs
    }
    if k == 8 {                            // unary: '!' -> bool
        if nd[i * 8 + 3] == 60 { return t_bool(st); }
        return cinfer(p, st, nd[i * 8 + 1]);
    }
    if k == 9 {                            // binary: comparisons and
        c := nd[i * 8 + 3];                // logic -> bool, arithmetic
        if c == 54 || c == 55 || c == 56 || c == 57 || c == 58 || c == 59
            || c == 61 || c == 62 { return t_bool(st); }
        return cinfer(p, st, nd[i * 8 + 1]);   // left operand rules
    }
    if k == 10 {                           // cast: authoritative
        return T{ pt: nd[i * 8 + 2], us: nd[i * 8 + 3], s: nd[i * 8 + 5], l: nd[i * 8 + 6] };
    }
    if k == 11 || k == 12 {                // struct / enum literal: its
        return T{ pt: 0, us: 0, s: nd[i * 8 + 5], l: nd[i * 8 + 6] };   // name
    }
    if k == 13 {                           // index: element type
        bt := cinfer(p, st, nd[i * 8 + 1]);
        if bt.pt > 0 {
            return T{ pt: bt.pt - 1, us: 0, s: bt.s, l: bt.l };
        }
        if span_is(p, bt, st[44] + 7, 3) { return t_u8(st); }   // str
        return t_i64(st);
    }
    return t_i64(st);
}

#[caps(syscall)]
fn main() -> i64 {
    path := "/tmp/n_check_target.n";
    fd := sys_open(path.ptr as *u8, 0, 0);
    if fd < 0 {
        put("(no check target - skipped)\n");
        return 0;
    }
    buf := sys_sbrk(262144) as *u8;        // 256K, parse.n's size
    mut total := 0;
    mut r := 1;
    while r > 0 {
        r = sys_read(fd, (buf as addr + total as addr) as *u8, 16384);
        if r > 0 { total = total + r; }
    }
    sys_close(fd);
    if total < 1 { return 0; }
    inb := "i64boolstru8u64void";          // the intern tail: synthesized
    mut z2 := 0;                           // type names live AFTER the
    while z2 < 19 {                        // source, same buffer — spans
        buf[total + z2] = inb.ptr[z2];     // stay uniform, the lexer's
        z2 = z2 + 1;                       // length never includes them
    }
    st := sys_sbrk(512) as *i64;
    ps := sys_sbrk(1024) as *i64;          // the params arena
    st[33] = sys_sbrk(1048576);            // nodes: 16K x 8 words
    st[34] = 1;                            // node 0 is nil
    st[35] = sys_sbrk(131072);             // the flat list arena
    st[36] = 0;
    st[37] = sys_sbrk(16384);              // fn table: 256 records
    st[38] = 0;
    st[39] = sys_sbrk(8192);               // vars: 256 x 3 words
    st[40] = 0;
    st[41] = 0;                            // the error flag
    st[42] = 0;                            // CUR_FN_CAPS
    st[43] = 0;                            // block depth
    st[44] = total;                        // the intern base
    st[49] = sys_sbrk(8192);               // the struct table
    st[50] = 0;
    nil0 := st[33] as *i64;                // node 0: an explicit nil
    mut z := 0;
    while z < 8 { nil0[z] = 0; z = z + 1; }
    st[0] = 0;
    st[1] = 1;
    st[2] = -1;
    st[3] = 0;
    st[4] = 0;
    st[32] = 0;
    adv(buf, total, st);                   // prime NEXT
    adv(buf, total, st);                   // ... and CUR
    pitems(buf, total, st, ps);            // ONE pass: tables + trees
    if st[41] == 1 { return 1; }           // a parse-time refusal (cname)
    ft := st[37] as *i64;
    mut i := 0;                            // check fns in declaration
    while i < st[38] {                     // order; first error stops
        if ft[i * 8 + 6] == 1 {
            cfn(buf, st, i);
            if st[41] == 1 { return 1; }
        }
        i = i + 1;
    }
    0
}
