// gfield.npp — N++ generic struct fields of generic type (M6.3h).
//
// A generic struct may hold another generic instantiated with its own
// parameters: `Pair<T>` keeps a `Box<T>`, `Two<A, B>` a `Box<A>` and a
// `Box<B>`. Each concrete `Pair<i64>` or `Two<i64, str>` instantiates the
// boxes it needs — nothing else has to mention `Box<i64>` — and the emitted
// struct names them by their concrete names. Generics now compose across
// structs, functions, and enums alike. Box<T> comes first: a concrete item
// is emitted where its template is declared.

extern syscall {
    fn write(fd: i32, buf: *u8, len: isize) -> i64 = 1
}

struct Box<T> {
    val: T,
}

struct Pair<T> {
    a: Box<T>,
    b: T,
}

struct Two<A, B> {
    x: Box<A>,
    y: Box<B>,
}

fn put(s: str) {
    write(1, s.ptr as *u8, s.len as isize);
}

fn main() -> i64 {
    p := Pair<i64>{ a: Box<i64>{ val: 40 }, b: 2 };
    t := Two<i64, str>{ x: Box<i64>{ val: 7 }, y: Box<str>{ val: "seven" } };
    sum := p.a.val + p.b;
    put("{p.a.val} + {p.b} = {sum}\n");
    put("{t.x.val} is {t.y.val}\n");
    sum - 42
}
