// nparse.n — the M5 chain, token-native end to end: a complete toy
//   compiler with FUNCTIONS and REAL IDENTIFIERS. lex → parse → emit →
//   run, in N's own surface syntax:
//       fn fact(n) { r := 1; if n > 1 { r := n * fact(n - 1); } r } fact(5)
//   The lexer fills a token buffer (sbrk'd i64 arrays, v0.16 index
//   stores); the parser consumes TOKENS and emits stack code; the VM
//   runs it. The grammar covers the whole toy language:
//     program := { fndef } { stmt } cmp
//     fndef   := 'fn' name '(' name { ',' name } ')' '{' { stmt } cmp '}'
//     stmt    := name ':=' cmp ';'
//              | 'if' cmp block [ 'else' block ]
//              | 'while' cmp block
//   `else` compiles as the classic diamond: the condition's JZ is
//   patched to the else entry, and the then-arm ends in a JMP patched
//   past the whole statement — two placeholder patches per if/else.
//   Since the selfhost road's rung 2 the toy also REFUSES bad input:
//   every token records its source line, the parser checks its expect
//   points (')', ';', braces, trailing input), and the first violation
//   prints "line N: error: ..." and stops — a parser is not real until
//   wrong input gets a message instead of undefined behavior.
//   Identifiers are INTERNED, the way ncc's own VARS table works: the
//   lexer keeps a symbol table (a names byte-buffer plus per-symbol
//   start/len), looks every alpha span up by byte comparison, appends
//   the ones it has never seen, and the token's value IS the symbol
//   index. Everything downstream — variable slots, function entry and
//   parameter tables — keys off symbol indexes, so the parser did not
//   change at all when names grew from one letter to words: that is
//   the token architecture paying rent. Keywords (if/while/fn) are
//   exact-matched before interning.
//   A function body has the same shape as a program — statements, then
//   the value it returns. A JMP patched over the fndefs starts
//   execution at the main statements; entries are recorded BEFORE
//   bodies compile (self-recursion resolves); calls are CALLER-SAVE
//   over the flat table, which is why recursion — and shared parameter
//   names across functions — work with no frame machinery. With
//   multiple parameters the discipline generalizes, and the STACK
//   dictates the order twice over: (1) save every callee slot, in
//   declaration order; (2) evaluate ALL the arguments before binding
//   any — so an argument like `a % b` in `gcd(b, a % b)` still reads
//   the OLD values — then STORE them in REVERSE (a pop hands back the
//   last argument first); (3) CALL; (4) restore each saved slot in
//   reverse with SWAP + STORE, working down the stack beneath the
//   returned value. `if`/`while` compile with branch patching.
//   Token encoding: kind 0 = number (val = its value), 1 = identifier
//   (val = its SYMBOL INDEX), 2 = operator/punct (val = its byte),
//   3 = '==', 4 = ':=', 5 = 'if', 6 = 'while', 7 = 'fn', 8 = 'else',
//   9 = end.
//   Opcodes: 0 HALT · 1 PUSH arg · 2 ADD · 3 SUB · 4 MUL · 5 DIV ·
//   6 MOD · 7 NEG · 8 LT · 9 GT · 10 EQ · 11 LOAD slot · 12 STORE slot
//   · 13 JZ target · 14 JMP target · 15 CALL target (pushes the return
//   address) · 16 RET (returns the top value) · 17 SWAP.

#[caps(syscall)]
extern syscall {
    fn write(fd: i32, buf: #[user] *u8, len: isize) -> i64 = 1
    fn sys_sbrk(incr: i64) -> i64                          = 7
    fn sys_exit(code: i64) -> never                        = 0
}

#[caps(syscall)]
fn put(s: str) {
    write(1, s.ptr as #[user] *u8, s.len as isize);
}

#[caps(syscall)]
fn alloc_words(n: i64) -> *i64 {
    sys_sbrk(n * 8) as *i64
}

#[caps(syscall)]
fn alloc_bytes(n: i64) -> *u8 {
    sys_sbrk(n) as *u8
}

fn is_digit(b: i64) -> bool { b >= 48 && b <= 57 }
fn is_letter(b: i64) -> bool { b >= 97 && b <= 122 }

// Scan src into the two token arrays; returns the token count. The
// last token is always the end marker (kind 9), so the parser can
// stop without carrying the count around. Identifiers intern into the
// symbol table (nb = names bytes, ss/sl = per-symbol start/len): a
// span already seen yields its existing index, a new one is appended —
// the same move ncc's vars_find/vars_add makes over its VARS table.
fn lex(src: str, k: *i64, v: *i64, ln: *i64, nb: *u8, ss: *i64, sl: *i64) -> i64 {
    n := src.len as i64;
    mut i := 0;
    mut t := 0;
    mut ns := 0;                           // interned symbol count
    mut nl := 0;                           // names buffer length
    mut line := 1;                         // 1-based, for diagnostics (rung 2)
    while i < n {
        b := src[i] as i64;
        if b == 32 || b == 9 || b == 13 {  // space / tab / CR
            i += 1;
            continue;
        }
        if b == 10 {                       // newline: the diagnostic counter
            line += 1;
            i += 1;
            continue;
        }
        ln[t] = line;                      // every token records its line
        if is_digit(b) {
            mut val := 0;
            while i < n && is_digit(src[i] as i64) {
                val = val * 10 + (src[i] as i64 - 48);
                i += 1;
            }
            k[t] = 0; v[t] = val; t += 1;
            continue;
        }
        if is_letter(b) {                  // keyword or identifier
            st := i;
            mut j := i;
            while j < n && is_letter(src[j] as i64) {
                j += 1;
            }
            len := j - st;
            mut kind := 1;
            if len == 2 && src[st] as i64 == 105 && src[st + 1] as i64 == 102 {
                kind = 5;                  // if
            }
            if len == 2 && src[st] as i64 == 102 && src[st + 1] as i64 == 110 {
                kind = 7;                  // fn
            }
            if len == 5 && src[st] as i64 == 119 && src[st + 1] as i64 == 104
                && src[st + 2] as i64 == 105 && src[st + 3] as i64 == 108
                && src[st + 4] as i64 == 101 {
                kind = 6;                  // while
            }
            if len == 4 && src[st] as i64 == 101 && src[st + 1] as i64 == 108
                && src[st + 2] as i64 == 115 && src[st + 3] as i64 == 101 {
                kind = 8;                  // else
            }
            mut val := 0;
            if kind == 1 {                 // intern: look the span up ...
                mut idx := -1;
                mut s := 0;
                while s < ns {
                    if sl[s] == len {
                        mut eq := true;
                        mut q := 0;
                        while q < len {
                            if nb[ss[s] + q] as i64 != src[st + q] as i64 {
                                eq = false;
                            }
                            q += 1;
                        }
                        if eq && idx < 0 { idx = s; }
                    }
                    s += 1;
                }
                if idx < 0 {               // ... or append a new symbol
                    ss[ns] = nl;
                    sl[ns] = len;
                    mut q := 0;
                    while q < len {
                        nb[nl + q] = src[st + q];
                        q += 1;
                    }
                    nl += len;
                    idx = ns;
                    ns += 1;
                }
                val = idx;
            }
            k[t] = kind; v[t] = val; t += 1;
            i = j;
            continue;
        }
        if b == 58 && i + 1 < n && src[i + 1] as i64 == 61 {
            k[t] = 4; v[t] = 0; t += 1;    // :=
            i += 2;
            continue;
        }
        if b == 61 && i + 1 < n && src[i + 1] as i64 == 61 {
            k[t] = 3; v[t] = 0; t += 1;    // ==
            i += 2;
            continue;
        }
        k[t] = 2; v[t] = b; t += 1;        // operator / punct, by byte
        i += 1;
    }
    k[t] = 9; v[t] = 0; ln[t] = line;      // end marker
    t + 1
}

// Rung 2 of the selfhost road: the toy REFUSES bad input instead of
// wandering into undefined behavior. First error wins; the message
// carries the token's source line. (It exits with status 0 so the test
// harness — which treats a non-zero exit as an example crash — stays
// strict for everything else; a real compiler would exit 1.)
#[caps(syscall)]
fn fail(line: i64, msg: str) -> never {
    put("line {line}: error: {msg}\n");
    sys_exit(0);
}

// Both cursors, threaded functionally: pos walks tokens, cp walks code.
struct EP { pos: i64, cp: i64 }

fn emit1(code: *i64, cp: i64, op: i64) -> i64 {
    code[cp] = op;
    cp + 1
}

fn emit2(code: *i64, cp: i64, op: i64, arg: i64) -> i64 {
    code[cp] = op;
    code[cp + 1] = arg;
    cp + 2
}

// factor := number | name '(' cmp { ',' cmp } ')' | name
//         | '-' factor | '(' cmp ')'
//   A call is the caller-save discipline over the flat table, and the
//   stack fixes the order twice: save every callee slot in declaration
//   order; evaluate ALL the arguments (so none of them sees a new
//   binding), then STORE them in reverse — a pop hands back the last
//   argument first; CALL; then restore each saved slot in reverse with
//   SWAP + STORE, working down the stack beneath the returned value.
fn parse_factor(k: *i64, v: *i64, ln: *i64, fe: *i64, fp: *i64, fpc: *i64, pos: i64, code: *i64, cp: i64) -> EP {
    if k[pos] == 0 {
        return EP{ pos: pos + 1, cp: emit2(code, cp, 1, v[pos]) };
    }
    if k[pos] == 1 && k[pos + 1] == 2 && v[pos + 1] == 40 {
        f := v[pos];                       // name '(' — a call
        cnt := fpc[f];
        mut c := cp;
        mut j := 0;
        while j < cnt {                    // save the callee's slots, in order
            c = emit2(code, c, 11, fp[f * 4 + j]);
            j += 1;
        }
        mut p := pos + 2;
        mut a := 0;
        while a < cnt {                    // all arguments, before any binds
            r := parse_cmp(k, v, ln, fe, fp, fpc, p, code, c);
            p = r.pos;
            c = r.cp;
            if k[p] == 2 && v[p] == 44 {   // ',' between arguments
                p += 1;
            }
            a += 1;
        }
        mut w := cnt - 1;
        while w > -1 {                     // bind in reverse: pops give the
            c = emit2(code, c, 12, fp[f * 4 + w]);   // last argument first
            w -= 1;
        }
        c = emit2(code, c, 15, fe[f]);     // CALL the entry
        mut u := cnt - 1;
        while u > -1 {                     // restore in reverse, beneath the
            c = emit1(code, c, 17);        // returned value: SWAP + STORE
            c = emit2(code, c, 12, fp[f * 4 + u]);
            u -= 1;
        }
        if !(k[p] == 2 && v[p] == 41) {
            fail(ln[p], "expected ')' after the arguments");
        }
        return EP{ pos: p + 1, cp: c };    // skip ')'
    }
    if k[pos] == 1 {                       // name read: LOAD its slot
        return EP{ pos: pos + 1, cp: emit2(code, cp, 11, v[pos]) };
    }
    if k[pos] == 2 && v[pos] == 45 {       // unary minus: operand, then NEG
        r := parse_factor(k, v, ln, fe, fp, fpc, pos + 1, code, cp);
        return EP{ pos: r.pos, cp: emit1(code, r.cp, 7) };
    }
    if k[pos] == 2 && v[pos] == 40 {       // '(' — mutual recursion
        r := parse_cmp(k, v, ln, fe, fp, fpc, pos + 1, code, cp);
        if !(k[r.pos] == 2 && v[r.pos] == 41) {
            fail(ln[r.pos], "expected ')'");
        }
        return EP{ pos: r.pos + 1, cp: r.cp };
    }
    fail(ln[pos], "expected an expression");
    EP{ pos: pos, cp: cp }                 // unreachable; keeps the lowering total
}

// term := factor (('*' | '/' | '%') factor)*  — op emitted after its rhs
fn parse_term(k: *i64, v: *i64, ln: *i64, fe: *i64, fp: *i64, fpc: *i64, pos: i64, code: *i64, cp: i64) -> EP {
    mut r := parse_factor(k, v, ln, fe, fp, fpc, pos, code, cp);
    mut going := true;
    while going {
        going = false;
        if k[r.pos] == 2 && (v[r.pos] == 42 || v[r.pos] == 47 || v[r.pos] == 37) {
            op := v[r.pos];
            n := parse_factor(k, v, ln, fe, fp, fpc, r.pos + 1, code, r.cp);
            mut oc := 4;                   // MUL
            if op == 47 { oc = 5; }        // DIV
            if op == 37 { oc = 6; }        // MOD
            r = EP{ pos: n.pos, cp: emit1(code, n.cp, oc) };
            going = true;
        }
    }
    r
}

// sum := term (('+' | '-') term)*
fn parse_sum(k: *i64, v: *i64, ln: *i64, fe: *i64, fp: *i64, fpc: *i64, pos: i64, code: *i64, cp: i64) -> EP {
    mut r := parse_term(k, v, ln, fe, fp, fpc, pos, code, cp);
    mut going := true;
    while going {
        going = false;
        if k[r.pos] == 2 && (v[r.pos] == 43 || v[r.pos] == 45) {
            op := v[r.pos];
            n := parse_term(k, v, ln, fe, fp, fpc, r.pos + 1, code, r.cp);
            mut oc := 2;                   // ADD
            if op == 45 { oc = 3; }        // SUB
            r = EP{ pos: n.pos, cp: emit1(code, n.cp, oc) };
            going = true;
        }
    }
    r
}

// cmp := sum [('<' | '>' | '==') sum]   — lowest tier, pushes 0 or 1
fn parse_cmp(k: *i64, v: *i64, ln: *i64, fe: *i64, fp: *i64, fpc: *i64, pos: i64, code: *i64, cp: i64) -> EP {
    l := parse_sum(k, v, ln, fe, fp, fpc, pos, code, cp);
    two := k[l.pos] == 3;
    one := k[l.pos] == 2 && (v[l.pos] == 60 || v[l.pos] == 62);
    if two || one {
        mut oc := 10;                      // EQ
        if one && v[l.pos] == 60 { oc = 8; }   // LT
        if one && v[l.pos] == 62 { oc = 9; }   // GT
        r := parse_sum(k, v, ln, fe, fp, fpc, l.pos + 1, code, l.cp);
        return EP{ pos: r.pos, cp: emit1(code, r.cp, oc) };
    }
    l
}

// A statement begins with `if`, `while`, or a name followed by ':='.
fn is_stmt_start(k: *i64, pos: i64) -> bool {
    k[pos] == 5 || k[pos] == 6 || (k[pos] == 1 && k[pos + 1] == 4)
}

// stmt := name ':=' cmp ';' | 'if' cmp block | 'while' cmp block
//   Control flow is where the emitter earns its keep — the jump target
//   is not known until the body has been compiled, so the JZ is emitted
//   with a placeholder and PATCHED afterwards (one index store into the
//   code buffer). `while` also emits the back-JMP to its condition, and
//   the JZ patch lands past that jump.
fn parse_stmt(k: *i64, v: *i64, ln: *i64, fe: *i64, fp: *i64, fpc: *i64, pos: i64, code: *i64, cp: i64) -> EP {
    if k[pos] == 5 {                       // if cmp block [else block]
        c := parse_cmp(k, v, ln, fe, fp, fpc, pos + 1, code, cp);
        hole := c.cp + 1;                  // the JZ's target word
        r := parse_block(k, v, ln, fe, fp, fpc, c.pos, code, emit2(code, c.cp, 13, 0));
        if k[r.pos] == 8 {                 // else: the classic diamond —
            hole2 := r.cp + 1;             // the then-arm hops past the else,
            c2 := emit2(code, r.cp, 14, 0);
            code[hole] = c2;               // false lands at the else entry,
            e := parse_block(k, v, ln, fe, fp, fpc, r.pos + 1, code, c2);
            code[hole2] = e.cp;            // and the hop lands past it all
            return e;
        }
        code[hole] = r.cp;                 // no else: skip the body when false
        return r;
    }
    if k[pos] == 6 {                       // while cmp { stmts }
        top := cp;
        c := parse_cmp(k, v, ln, fe, fp, fpc, pos + 1, code, cp);
        hole := c.cp + 1;
        r := parse_block(k, v, ln, fe, fp, fpc, c.pos, code, emit2(code, c.cp, 13, 0));
        e := emit2(code, r.cp, 14, top);   // back to the condition
        code[hole] = e;                    // exit lands past the back-jump
        return EP{ pos: r.pos, cp: e };
    }
    slot := v[pos];                        // name ':=' cmp ';'
    r := parse_cmp(k, v, ln, fe, fp, fpc, pos + 2, code, cp);
    if !(k[r.pos] == 2 && v[r.pos] == 59) {
        fail(ln[r.pos], "expected ';' after the binding");
    }
    EP{ pos: r.pos + 1, cp: emit2(code, r.cp, 12, slot) }
}

// block := '{' { stmt } '}'   — statement-only; a block has no tail.
fn parse_block(k: *i64, v: *i64, ln: *i64, fe: *i64, fp: *i64, fpc: *i64, pos: i64, code: *i64, cp: i64) -> EP {
    if !(k[pos] == 2 && v[pos] == 123) {
        fail(ln[pos], "expected '\{'");
    }
    mut p := pos + 1;                      // skip '{'
    mut c := cp;
    mut more := true;
    while more {
        more = false;
        if is_stmt_start(k, p) {
            r := parse_stmt(k, v, ln, fe, fp, fpc, p, code, c);
            p = r.pos;
            c = r.cp;
            more = true;
        }
    }
    if !(k[p] == 2 && v[p] == 125) {
        fail(ln[p], "expected '\}' or a statement");
    }
    EP{ pos: p + 1, cp: c }                // skip '}'
}

// fndef := 'fn' name '(' name { ',' name } ')' '{' { stmt } cmp '}'
//   The entry address is recorded BEFORE the body compiles, so a
//   function may call itself; up to four comma-separated parameters
//   record their slots in fp[f*4 + j] with the count in fpc[f]; the
//   body ends in RET, which returns its tail value.
fn parse_fndef(k: *i64, v: *i64, ln: *i64, fe: *i64, fp: *i64, fpc: *i64, pos: i64, code: *i64, cp: i64) -> EP {
    f := v[pos + 1];
    fe[f] = cp;
    mut p := pos + 3;                      // fn +0, name +1, '(' +2, params...
    mut j := 0;
    mut going := true;
    while going {
        going = false;
        if k[p] == 1 {
            fp[f * 4 + j] = v[p];
            j += 1;
            p += 1;
            if k[p] == 2 && v[p] == 44 {   // ',' — another parameter follows
                p += 1;
                going = true;
            }
        }
    }
    fpc[f] = j;
    p += 2;                                // skip ')' '{'
    mut c := cp;
    mut more := true;
    while more {
        more = false;
        if is_stmt_start(k, p) {
            r := parse_stmt(k, v, ln, fe, fp, fpc, p, code, c);
            p = r.pos;
            c = r.cp;
            more = true;
        }
    }
    t := parse_cmp(k, v, ln, fe, fp, fpc, p, code, c);  // body tail = return value
    EP{ pos: t.pos + 1, cp: emit1(code, t.cp, 16) }   // skip '}', RET
}

// program := { fndef } { stmt } cmp
//   If any functions exist, a JMP with a placeholder target is emitted
//   first and patched to hop over their bodies — execution starts at
//   the main statements, functions are entered only by CALL.
fn parse_program(k: *i64, v: *i64, ln: *i64, fe: *i64, fp: *i64, fpc: *i64, pos: i64, code: *i64, cp: i64) -> EP {
    mut p := pos;
    mut c := cp;
    if k[p] == 7 {
        c = emit2(code, c, 14, 0);
        hole := c - 1;                     // the hop-over JMP's target
        mut fns := true;
        while fns {
            fns = false;
            if k[p] == 7 {
                r := parse_fndef(k, v, ln, fe, fp, fpc, p, code, c);
                p = r.pos;
                c = r.cp;
                fns = true;
            }
        }
        code[hole] = c;                    // main statements start here
    }
    mut more := true;
    while more {
        more = false;
        if is_stmt_start(k, p) {
            r := parse_stmt(k, v, ln, fe, fp, fpc, p, code, c);
            p = r.pos;
            c = r.cp;
            more = true;
        }
    }
    t := parse_cmp(k, v, ln, fe, fp, fpc, p, code, c);
    if k[t.pos] != 9 {
        fail(ln[t.pos], "unexpected input after the tail expression");
    }
    t
}

// The stack machine: arithmetic, comparisons, a variable table, jumps,
// and calls. CALL pushes the return address and jumps; RET consumes it
// beneath the return value; SWAP serves the caller-save restore.
fn run(prog: *i64, stk: *i64, vars: *i64) -> i64 {
    mut pc := 0;
    mut sp := 0;
    mut running := true;
    while running {
        op := prog[pc];
        if op == 0 { running = false; }
        if op == 1 { stk[sp] = prog[pc + 1]; sp += 1; pc += 2; }
        if op == 2 { stk[sp - 2] = stk[sp - 2] + stk[sp - 1]; sp -= 1; pc += 1; }
        if op == 3 { stk[sp - 2] = stk[sp - 2] - stk[sp - 1]; sp -= 1; pc += 1; }
        if op == 4 { stk[sp - 2] = stk[sp - 2] * stk[sp - 1]; sp -= 1; pc += 1; }
        if op == 5 { stk[sp - 2] = stk[sp - 2] / stk[sp - 1]; sp -= 1; pc += 1; }
        if op == 6 { stk[sp - 2] = stk[sp - 2] % stk[sp - 1]; sp -= 1; pc += 1; }
        if op == 7 { stk[sp - 1] = -stk[sp - 1]; pc += 1; }
        if op == 8 {
            mut t := 0;
            if stk[sp - 2] < stk[sp - 1] { t = 1; }
            stk[sp - 2] = t; sp -= 1; pc += 1;
        }
        if op == 9 {
            mut t := 0;
            if stk[sp - 2] > stk[sp - 1] { t = 1; }
            stk[sp - 2] = t; sp -= 1; pc += 1;
        }
        if op == 10 {
            mut t := 0;
            if stk[sp - 2] == stk[sp - 1] { t = 1; }
            stk[sp - 2] = t; sp -= 1; pc += 1;
        }
        if op == 11 { stk[sp] = vars[prog[pc + 1]]; sp += 1; pc += 2; }
        if op == 12 { sp -= 1; vars[prog[pc + 1]] = stk[sp]; pc += 2; }
        if op == 13 {
            sp -= 1;
            if stk[sp] == 0 { pc = prog[pc + 1]; } else { pc += 2; }
        }
        if op == 14 { pc = prog[pc + 1]; }
        if op == 15 { stk[sp] = pc + 2; sp += 1; pc = prog[pc + 1]; }
        if op == 16 {
            rv := stk[sp - 1];             // the body's tail value
            pc = stk[sp - 2];              // the pushed return address
            stk[sp - 2] = rv;
            sp -= 1;
        }
        if op == 17 {
            t := stk[sp - 1];
            stk[sp - 1] = stk[sp - 2];
            stk[sp - 2] = t;
            pc += 1;
        }
    }
    stk[0]
}

// The whole pipeline in one call: tokens in, code out, value from the VM.
fn show(src: str, k: *i64, v: *i64, ln: *i64, code: *i64, stk: *i64, vars: *i64,
        fe: *i64, fp: *i64, fpc: *i64, nb: *u8, ss: *i64, sl: *i64) {
    lex(src, k, v, ln, nb, ss, sl);
    r := parse_program(k, v, ln, fe, fp, fpc, 0, code, 0);
    words := emit1(code, r.cp, 0);         // HALT closes the program
    val := run(code, stk, vars);
    put("{src}\n  ->  {val}   [{words} code words]\n");
}

fn main() -> i64 {
    k := alloc_words(96);
    v := alloc_words(96);
    code := alloc_words(256);
    stk := alloc_words(64);
    vars := alloc_words(64);               // slots are symbol indexes
    fe := alloc_words(64);
    fp := alloc_words(256);                // 64 fns x up to 4 param slots
    fpc := alloc_words(64);
    nb := alloc_bytes(256);                // the interned-names buffer
    ss := alloc_words(64);
    sl := alloc_words(64);
    ln := alloc_words(96);                 // per-token source lines (rung 2)
    put("else, diagnostics, functions - lex -> parse -> emit -> run:\n");
    // Braces are escaped so they read as text, not interpolation (§2.5).
    show("fn max(a, b) \{ m := 0; if a > b \{ m := a; \} else \{ m := b; \} m \} max(3, 9) + max(7, 2)",
         k, v, ln, code, stk, vars, fe, fp, fpc, nb, ss, sl);
    show("fn gcd(a, b) \{ r := a; if b > 0 \{ r := gcd(b, a % b); \} r \} gcd(48, 18)",
         k, v, ln, code, stk, vars, fe, fp, fpc, nb, ss, sl);
    show("fn fact(n) \{ r := 1; if n > 1 \{ r := n * fact(n - 1); \} r \} fact(5)",
         k, v, ln, code, stk, vars, fe, fp, fpc, nb, ss, sl);
    // The broken program runs LAST: the toy now refuses bad input with a
    // located message, and fail() ends the process (first error wins).
    put("and a deliberately broken program:\n");
    show("a := 1;\nb := (a + ;\nb",
         k, v, ln, code, stk, vars, fe, fp, fpc, nb, ss, sl);
    0
}
