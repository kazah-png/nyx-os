// nparse.n — the M5 chain WIRED: lex into a token buffer, parse tokens.
//   ntokens.n scans N source and ncalc.n evaluates expressions, but each
//   worked alone: ncalc re-reads raw characters inside its grammar. Real
//   compilers do not — the lexer runs first and the parser consumes its
//   TOKEN STREAM. This program closes that gap with the architecture
//   every later self-hosting step will use:
//     source str ──lex()──► kinds[] / vals[] (sbrk'd i64 buffers,
//     written with v0.16 index stores) ──parse──► value
//   The parser never touches a character: it walks token indexes with
//   the same PR{val,pos} functional threading ncalc introduced (no
//   globals in N — state rides the return value). On top of ncalc's
//   grammar it adds identifiers (a one-letter environment: x=10, y=4)
//   and comparisons < > ==, one precedence level below + and -.
//   Token encoding: kind 0 = number (val = its value), 1 = identifier
//   (val = environment index), 2 = operator/paren (val = its byte),
//   3 = the two-char operator '==', 9 = end of input.

#[caps(syscall)]
extern syscall {
    fn write(fd: i32, buf: #[user] *u8, len: isize) -> i64 = 1
    fn sys_sbrk(incr: i64) -> i64                          = 7
}

#[caps(syscall)]
fn put(s: str) {
    write(1, s.ptr as #[user] *u8, s.len as isize);
}

#[caps(syscall)]
fn alloc_words(n: i64) -> *i64 {
    sys_sbrk(n * 8) as *i64
}

fn is_digit(b: i64) -> bool { b >= 48 && b <= 57 }

// The fixed environment: x = 10, y = 4.
fn env(id: i64) -> i64 {
    if id == 0 {
        return 10;
    }
    4
}

// Scan src into the two token arrays; returns the token count. The
// last token is always the end marker (kind 9), so the parser can
// stop without carrying the count around.
fn lex(src: str, k: *i64, v: *i64) -> i64 {
    n := src.len as i64;
    mut i := 0;
    mut t := 0;
    while i < n {
        b := src[i] as i64;
        if b == 32 {                       // space
            i += 1;
            continue;
        }
        if is_digit(b) {
            mut val := 0;
            while i < n && is_digit(src[i] as i64) {
                val = val * 10 + (src[i] as i64 - 48);
                i += 1;
            }
            k[t] = 0; v[t] = val; t += 1;
            continue;
        }
        if b == 120 || b == 121 {          // x | y — the environment
            k[t] = 1;
            if b == 120 { v[t] = 0; } else { v[t] = 1; }
            t += 1;
            i += 1;
            continue;
        }
        if b == 61 && i + 1 < n && src[i + 1] as i64 == 61 {
            k[t] = 3; v[t] = 0; t += 1;    // ==
            i += 2;
            continue;
        }
        k[t] = 2; v[t] = b; t += 1;        // operator / paren, by byte
        i += 1;
    }
    k[t] = 9; v[t] = 0;                    // end marker
    t + 1
}

// Functional state threading, one level per precedence tier: each rule
// takes the token arrays and a position, and returns PR{val, pos}.
struct PR { val: i64, pos: i64 }

// factor := number | ident | '-' factor | '(' cmp ')'
fn parse_factor(k: *i64, v: *i64, pos: i64) -> PR {
    if k[pos] == 0 {
        return PR{ val: v[pos], pos: pos + 1 };
    }
    if k[pos] == 1 {
        return PR{ val: env(v[pos]), pos: pos + 1 };
    }
    if k[pos] == 2 && v[pos] == 45 {       // unary minus
        r := parse_factor(k, v, pos + 1);
        return PR{ val: -r.val, pos: r.pos };
    }
    r := parse_cmp(k, v, pos + 1);         // '(' — mutual recursion
    PR{ val: r.val, pos: r.pos + 1 }       // skip ')'
}

// term := factor (('*' | '/' | '%') factor)*
fn parse_term(k: *i64, v: *i64, pos: i64) -> PR {
    mut r := parse_factor(k, v, pos);
    mut going := true;
    while going {
        going = false;
        if k[r.pos] == 2 && (v[r.pos] == 42 || v[r.pos] == 47 || v[r.pos] == 37) {
            op := v[r.pos];
            n := parse_factor(k, v, r.pos + 1);
            mut val := r.val;
            if op == 42 { val = val * n.val; }
            if op == 47 { val = val / n.val; }
            if op == 37 { val = val % n.val; }
            r = PR{ val: val, pos: n.pos };
            going = true;
        }
    }
    r
}

// sum := term (('+' | '-') term)*
fn parse_sum(k: *i64, v: *i64, pos: i64) -> PR {
    mut r := parse_term(k, v, pos);
    mut going := true;
    while going {
        going = false;
        if k[r.pos] == 2 && (v[r.pos] == 43 || v[r.pos] == 45) {
            op := v[r.pos];
            n := parse_term(k, v, r.pos + 1);
            mut val := r.val;
            if op == 43 { val = val + n.val; }
            if op == 45 { val = val - n.val; }
            r = PR{ val: val, pos: n.pos };
            going = true;
        }
    }
    r
}

// cmp := sum [('<' | '>' | '==') sum]   — lowest tier, yields 0 or 1
fn parse_cmp(k: *i64, v: *i64, pos: i64) -> PR {
    l := parse_sum(k, v, pos);
    two := k[l.pos] == 3;
    one := k[l.pos] == 2 && (v[l.pos] == 60 || v[l.pos] == 62);
    if two || one {
        mut op := v[l.pos];
        if two { op = 200; }               // internal code for ==
        r := parse_sum(k, v, l.pos + 1);
        mut val := 0;
        if op == 60 && l.val < r.val  { val = 1; }
        if op == 62 && l.val > r.val  { val = 1; }
        if op == 200 && l.val == r.val { val = 1; }
        return PR{ val: val, pos: r.pos };
    }
    l
}

// The wired pipeline: one call runs both stages over shared buffers.
fn show(src: str, k: *i64, v: *i64) {
    lex(src, k, v);
    r := parse_cmp(k, v, 0);
    put("{src}  ->  {r.val}\n");
}

fn main() -> i64 {
    k := alloc_words(64);
    v := alloc_words(64);
    put("lex+parse with x=10, y=4:\n");
    show("2 + x * y", k, v);
    show("(2 + x) * y", k, v);
    show("x * y == 40", k, v);
    show("x - y < 5", k, v);
    0
}
